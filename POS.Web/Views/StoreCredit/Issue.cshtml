@{ ViewData["Title"] = "Issue Store Credit"; var customer = ViewBag.Customer as POS.Core.Entities.Customer; }
<div class="row justify-content-center"><div class="col-md-5">
<div class="card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-wallet2"></i> Issue Store Credit</h5></div>
    <div class="card-body">
        <p class="text-muted">Customer: <strong>@customer!.Name</strong></p>
        <form asp-action="Issue" asp-route-customerId="@customer.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Amount ($) <span class="text-danger">*</span></label>
                <div class="input-group"><span class="input-group-text">$</span><input name="amount" class="form-control" type="number" min="0.01" step="0.01" required /></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Notes</label>
                <input name="notes" class="form-control" placeholder="Reason for issuing credit..." />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Issue Credit</button>
                <a asp-action="Details" asp-route-customerId="@customer.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div></div>
