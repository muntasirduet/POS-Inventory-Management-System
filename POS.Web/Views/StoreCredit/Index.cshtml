@model List<POS.Core.Entities.StoreCreditAccount>
@{ ViewData["Title"] = "Store Credit Accounts"; }
<h4 class="mb-3"><i class="bi bi-wallet2"></i> Store Credit Accounts</h4>
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div> }
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Customer</th><th>Balance</th><th>Total Issued</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var sc in Model)
                {
                    <tr>
                        <td><strong>@sc.Customer.Name</strong></td>
                        <td class="fw-bold text-success fs-5">$@sc.Balance.ToString("0.00")</td>
                        <td class="text-muted">$@sc.TotalIssued.ToString("0.00")</td>
                        <td>
                            <a asp-action="Details" asp-route-customerId="@sc.CustomerId" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Issue" asp-route-customerId="@sc.CustomerId" class="btn btn-sm btn-outline-success">Issue More</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No store credit accounts with balance.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
