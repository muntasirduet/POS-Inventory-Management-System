@model IEnumerable<POS.Core.Entities.TaxGroup>
@{ ViewData["Title"] = "Tax Groups"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <div>
        <a asp-action="Components" class="btn btn-outline-secondary me-2">Manage Components</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Tax Group</a>
    </div>
</div>

@if (TempData["Success"] != null)
{ <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div> }

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr><th>Name</th><th>Description</th><th>Default</th><th>Components</th><th>Effective Rate</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    var effRate = g.Components.Sum(c => c.TaxComponent?.Rate ?? 0);
                    <tr>
                        <td>@g.Name</td>
                        <td><small class="text-muted">@g.Description</small></td>
                        <td>@if (g.IsDefault) { <span class="badge bg-success">Default</span> }</td>
                        <td>
                            @foreach (var c in g.Components)
                            { <span class="badge bg-secondary me-1">@c.TaxComponent?.Name (@c.TaxComponent?.Rate%)</span> }
                        </td>
                        <td><strong>@effRate%</strong></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this tax group?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="6" class="text-center py-4 text-muted">No tax groups defined yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
