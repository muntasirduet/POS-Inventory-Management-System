@model POS.Core.Entities.TaxComponent
@{ ViewData["Title"] = "Edit Tax Component"; }
<h2>@ViewData["Title"]</h2>
<div class="row"><div class="col-md-6">
<div class="card"><div class="card-body">
<form asp-action="EditComponent" method="post">
@Html.AntiForgeryToken()
<input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required /></div>
<div class="mb-3"><label asp-for="Code" class="form-label">Code</label><input asp-for="Code" class="form-control" /></div>
<div class="mb-3">
    <label asp-for="Rate" class="form-label">Rate (%)</label>
    <input asp-for="Rate" type="number" step="0.01" class="form-control" required />
</div>
<div class="mb-3 form-check">
    <input asp-for="IsInclusive" class="form-check-input" type="checkbox" />
    <label asp-for="IsInclusive" class="form-check-label">Price-inclusive tax</label>
</div>
<div class="mb-3 form-check">
    <input asp-for="IsCompound" class="form-check-input" type="checkbox" />
    <label asp-for="IsCompound" class="form-check-label">Compound tax</label>
</div>
<div class="mb-3"><label asp-for="SortOrder" class="form-label">Sort Order</label><input asp-for="SortOrder" type="number" class="form-control" style="width:100px" /></div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Components" class="btn btn-secondary ms-2">Cancel</a>
</form>
</div></div>
</div></div>
