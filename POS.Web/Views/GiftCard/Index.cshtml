@model List<POS.Core.Entities.GiftCard>
@{ ViewData["Title"] = "Gift Cards"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-gift-fill text-danger"></i> Gift Cards</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Issue Gift Card</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div> }
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Code</th><th>Initial Value</th><th>Balance</th><th>Issued To</th><th>Expires</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var gc in Model)
                {
                    <tr>
                        <td><code>@gc.Code</code></td>
                        <td>$@gc.InitialValue.ToString("0.00")</td>
                        <td class="fw-bold @(gc.Balance > 0 ? "text-success" : "text-muted")">$@gc.Balance.ToString("0.00")</td>
                        <td>@(gc.IssuedToCustomer?.Name ?? "—")</td>
                        <td>@(gc.ExpiresAt?.ToString("MMM d, yyyy") ?? "No expiry")</td>
                        <td>
                            @if (!gc.IsActive) { <span class="badge bg-secondary">Used</span> }
                            else if (gc.ExpiresAt.HasValue && gc.ExpiresAt < DateTime.UtcNow) { <span class="badge bg-danger">Expired</span> }
                            else { <span class="badge bg-success">Active</span> }
                        </td>
                        <td><a asp-action="Details" asp-route-id="@gc.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No gift cards issued yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
