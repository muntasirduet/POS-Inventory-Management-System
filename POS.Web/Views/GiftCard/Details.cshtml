@model POS.Core.Entities.GiftCard
@{ ViewData["Title"] = "Gift Card — " + Model.Code; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-gift-fill text-danger"></i> Gift Card</h4>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="row justify-content-center"><div class="col-md-6">
<div class="card text-center shadow">
    <div class="card-body py-4">
        <div class="mb-3"><span class="badge bg-@(Model.IsActive ? "success" : "secondary") fs-6">@(Model.IsActive ? "ACTIVE" : "USED/INACTIVE")</span></div>
        <div class="display-6 font-monospace fw-bold mb-2">@Model.Code</div>
        <div class="mb-1 text-muted small">Initial Value</div>
        <div class="fs-4 text-secondary">$@Model.InitialValue.ToString("0.00")</div>
        <div class="mb-1 text-muted small mt-3">Balance Remaining</div>
        <div class="display-5 fw-bold text-success">$@Model.Balance.ToString("0.00")</div>
        @if (Model.ExpiresAt.HasValue)
        {
            <div class="mt-3 small text-muted">Expires: @Model.ExpiresAt.Value.ToString("MMM d, yyyy")</div>
        }
        @if (Model.IssuedToCustomer != null)
        {
            <div class="mt-2 small text-muted">Issued to: @Model.IssuedToCustomer.Name</div>
        }
        <div class="mt-3 small text-muted">Issued: @Model.CreatedAt.ToString("MMM d, yyyy")</div>
    </div>
</div>
</div></div>
