@{ ViewData["Title"] = "Issue Gift Card"; }
<div class="row justify-content-center"><div class="col-md-5">
<div class="card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-gift-fill text-danger"></i> Issue Gift Card</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Value ($) <span class="text-danger">*</span></label>
                <div class="input-group"><span class="input-group-text">$</span><input name="value" class="form-control" type="number" min="1" step="0.01" required /></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Issue To Customer (optional)</label>
                <select name="customerId" class="form-select">
                    <option value="">Anonymous</option>
                    @foreach (var c in ViewBag.Customers as List<POS.Core.Entities.Customer> ?? new()) { <option value="@c.Id">@c.Name</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Expiry Date (optional)</label>
                <input name="expiresAt" type="date" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Issue Card</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div></div>
