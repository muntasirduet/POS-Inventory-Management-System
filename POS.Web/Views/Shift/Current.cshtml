@model POS.Core.Entities.Shift
@{ ViewData["Title"] = "Current Shift"; }
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Error"]</div> }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Active Shift <span class="badge bg-success fs-6">OPEN</span></h2>
    <a asp-action="Close" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-stop-circle me-1"></i>Close Shift</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center"><div class="card-body">
            <div class="fs-4 fw-bold">$@Model.OpeningCash.ToString("F2")</div>
            <div class="text-muted small">Opening Cash</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center"><div class="card-body">
            <div class="fs-4 fw-bold">@Model.StartTime.ToLocalTime().ToString("HH:mm")</div>
            <div class="text-muted small">Started</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center"><div class="card-body">
            <div class="fs-4 fw-bold text-success">+$@Model.CashEntries.Where(e=>e.Type=="CashIn").Sum(e=>e.Amount).ToString("F2")</div>
            <div class="text-muted small">Cash In</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center"><div class="card-body">
            <div class="fs-4 fw-bold text-danger">-$@Model.CashEntries.Where(e=>e.Type=="CashOut").Sum(e=>e.Amount).ToString("F2")</div>
            <div class="text-muted small">Cash Out</div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header fw-semibold">Cash Entry</div>
            <div class="card-body">
                <form asp-action="AddCashEntry" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="shiftId" value="@Model.Id" />
                    <div class="mb-2">
                        <select name="type" class="form-select">
                            <option value="CashIn">Cash In (paid-in / float)</option>
                            <option value="CashOut">Cash Out (paid-out / expense)</option>
                        </select>
                    </div>
                    <div class="mb-2"><input type="number" name="amount" step="0.01" min="0.01" class="form-control" placeholder="Amount" required /></div>
                    <div class="mb-2"><input type="text" name="reason" class="form-control" placeholder="Reason (optional)" /></div>
                    <button type="submit" class="btn btn-primary btn-sm">Record</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header fw-semibold">Cash Entries</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Time</th><th>Type</th><th>Amount</th><th>Reason</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.CashEntries.OrderByDescending(e => e.CreatedAt))
                        {
                            <tr>
                                <td>@e.CreatedAt.ToLocalTime().ToString("HH:mm")</td>
                                <td><span class="badge @(e.Type=="CashIn"?"bg-success":"bg-danger")">@e.Type</span></td>
                                <td>$@e.Amount.ToString("F2")</td>
                                <td><small>@e.Reason</small></td>
                            </tr>
                        }
                        @if (!Model.CashEntries.Any()) { <tr><td colspan="4" class="text-center text-muted">No entries yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
