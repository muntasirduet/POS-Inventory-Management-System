@{ ViewData["Title"] = "Reports"; }
<h2><i class="bi bi-bar-chart"></i> Reports</h2>
<div class="row g-3 mt-2">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title"><i class="bi bi-receipt text-success"></i> Sales Report</h5>
                <p class="card-text text-muted small">View and export sales transactions by date range and branch.</p>
                <a asp-action="Sales" class="btn btn-success mt-auto">Open <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title"><i class="bi bi-boxes text-primary"></i> Inventory Report</h5>
                <p class="card-text text-muted small">View stock valuation and on-hand quantities by branch.</p>
                <a asp-action="Inventory" class="btn btn-primary mt-auto">Open <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    @if (User.HasClaim("permission", "reports.audit"))
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title"><i class="bi bi-shield-check text-warning"></i> Audit Logs</h5>
                    <p class="card-text text-muted small">Review system-wide audit trail of all user actions.</p>
                    <a asp-action="AuditLogs" class="btn btn-warning mt-auto">Open <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    }
</div>
