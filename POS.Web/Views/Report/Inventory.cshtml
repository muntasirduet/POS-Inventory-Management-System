@model POS.Application.DTOs.InventoryReportDto
@{ ViewData["Title"] = "Inventory Report"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-boxes"></i> Inventory Report</h2>
    <a asp-action="ExportInventoryExcel" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Export Excel</a>
</div>
@{
    var totalValue = Model.Rows.Sum(r => r.StockValue);
    var totalQty = Model.Rows.Sum(r => r.QtyOnHand);
}
<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card text-white bg-primary shadow-sm"><div class="card-body"><div class="small">Total Products (lines)</div><div class="fs-5 fw-bold">@Model.Rows.Count</div></div></div></div>
    <div class="col-md-4"><div class="card text-white bg-info shadow-sm"><div class="card-body"><div class="small">Total Units On Hand</div><div class="fs-5 fw-bold">@totalQty</div></div></div></div>
    <div class="col-md-4"><div class="card text-white bg-success shadow-sm"><div class="card-body"><div class="small">Total Stock Value</div><div class="fs-5 fw-bold">$@totalValue.ToString("N2")</div></div></div></div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Branch</th>
                    <th class="text-end">Qty On Hand</th>
                    <th class="text-end">Reorder Level</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Stock Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var isLow = row.QtyOnHand <= row.ReorderLevel;
                    <tr class="@(isLow ? "table-warning" : "")">
                        <td>@row.ProductName @if (isLow) { <span class="badge bg-danger ms-1">Low</span> }</td>
                        <td><code>@row.SKU</code></td>
                        <td>@row.Branch</td>
                        <td class="text-end @(isLow ? "text-danger fw-bold" : "")">@row.QtyOnHand</td>
                        <td class="text-end">@row.ReorderLevel</td>
                        <td class="text-end">$@row.UnitPrice.ToString("N2")</td>
                        <td class="text-end fw-bold">$@row.StockValue.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No inventory data available.</td></tr>
                }
            </tbody>
            @if (Model.Rows.Any())
            {
                <tfoot class="table-secondary">
                    <tr>
                        <td colspan="3"><strong>Total</strong></td>
                        <td class="text-end"><strong>@totalQty</strong></td>
                        <td></td><td></td>
                        <td class="text-end"><strong>$@totalValue.ToString("N2")</strong></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
