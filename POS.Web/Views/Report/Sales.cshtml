@model POS.Application.DTOs.SalesReportDto
@{ ViewData["Title"] = "Sales Report"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-receipt"></i> Sales Report</h2>
    <a asp-action="ExportSalesExcel" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Export Excel</a>
</div>
<div class="card mb-3 shadow-sm">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto"><label class="form-label mb-0">From</label></div>
            <div class="col-md-2"><input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" /></div>
            <div class="col-auto"><label class="form-label mb-0">To</label></div>
            <div class="col-md-2"><input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" /></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Apply</button></div>
        </form>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card text-white bg-success shadow-sm"><div class="card-body"><div class="small">Total Revenue</div><div class="fs-5 fw-bold">$@Model.TotalRevenue.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card text-white bg-primary shadow-sm"><div class="card-body"><div class="small">Transactions</div><div class="fs-5 fw-bold">@Model.TransactionCount</div></div></div></div>
    <div class="col-md-3"><div class="card text-white bg-info shadow-sm"><div class="card-body"><div class="small">Net Revenue</div><div class="fs-5 fw-bold">$@Model.NetRevenue.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card text-white bg-warning shadow-sm"><div class="card-body"><div class="small">Total Discount</div><div class="fs-5 fw-bold">$@Model.TotalDiscount.ToString("N2")</div></div></div></div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Sale #</th>
                    <th>Date</th>
                    <th>Cashier</th>
                    <th>Customer</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><code>@row.SaleNumber</code></td>
                        <td>@row.Date.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>@row.Cashier</td>
                        <td>@(row.Customer ?? "—")</td>
                        <td class="text-end">$@row.Total.ToString("N2")</td>
                        <td><span class="badge @(row.Status == "Completed" ? "bg-success" : row.Status == "OnHold" ? "bg-warning text-dark" : "bg-secondary")">@row.Status</span></td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No sales found for the selected period.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
