@using POS.Web.Controllers
@model List<TaxReportRow>
@{ ViewData["Title"] = "Tax Report"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-receipt-cutoff"></i> Tax Report</h2>
    <a asp-action="ExportTaxCsv" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-branchId="@ViewBag.BranchId"
       class="btn btn-outline-success"><i class="bi bi-filetype-csv"></i> Export CSV</a>
</div>

<form asp-action="TaxReport" method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">From</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">To</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Branch</label>
                <select name="branchId" class="form-select form-select-sm">
                    <option value="">All Branches</option>
                    @foreach (var b in (ViewBag.Branches as IEnumerable<POS.Core.Entities.Branch> ?? []))
                    { <option value="@b.Id" selected="@(ViewBag.BranchId?.ToString() == b.Id.ToString() ? "selected" : null)">@b.Name</option> }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary btn-sm">Filter</button>
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No tax data found for the selected period.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Tax Rate Name</th>
                        <th class="text-end">Rate %</th>
                        <th class="text-end">Taxable Amount</th>
                        <th class="text-end">Tax Collected</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.TaxRateName</td>
                        <td class="text-end">@(r.Rate * 100).ToString("0.##")%</td>
                        <td class="text-end">$@r.TaxableAmount.ToString("N2")</td>
                        <td class="text-end fw-semibold">$@r.TaxAmount.ToString("N2")</td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="2">TOTAL</td>
                        <td class="text-end">$@Model.Sum(r => r.TaxableAmount).ToString("N2")</td>
                        <td class="text-end">$@Model.Sum(r => r.TaxAmount).ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
