@model POS.Core.Entities.Reward
@{ ViewData["Title"] = "New Reward"; }
<div class="row justify-content-center">
<div class="col-md-5">
<div class="card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-star-fill text-warning"></i> New Reward</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Reward Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Silver Discount" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PointsRequired" class="form-label">Points Required</label>
                <input asp-for="PointsRequired" class="form-control" type="number" min="1" required />
                <span asp-validation-for="PointsRequired" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DiscountValue" class="form-label">Discount Value ($)</label>
                <input asp-for="DiscountValue" class="form-control" type="number" min="0.01" step="0.01" required />
                <span asp-validation-for="DiscountValue" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Reward</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div></div>
