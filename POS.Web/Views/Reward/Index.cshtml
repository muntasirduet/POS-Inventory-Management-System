@model List<POS.Core.Entities.Reward>
@{ ViewData["Title"] = "Loyalty Rewards"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-star-fill text-warning"></i> Loyalty Rewards</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Reward</a>
</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div>
}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Points Required</th><th>Discount Value</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.Name</strong></td>
                        <td>@r.PointsRequired pts</td>
                        <td class="text-success fw-bold">-$@r.DiscountValue.ToString("0.00")</td>
                        <td>
                            @if (r.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@r.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(r.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    @(r.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this reward?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No rewards defined yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
