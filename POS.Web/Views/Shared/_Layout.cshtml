<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { display: flex; min-height: 100vh; flex-direction: column; }
        .sidebar { min-height: calc(100vh - 56px); background-color: #1e293b; color: #cbd5e1; width: 220px; flex-shrink: 0; }
        .sidebar .nav-link { color: #94a3b8; padding: 7px 14px; border-radius: 6px; margin-bottom: 2px; font-size: .88rem; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: #334155; color: #fff; }
        .sidebar .nav-link i { margin-right: 6px; }
        .sidebar .section-title { font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; padding: 10px 14px 3px; }
        .content-wrapper { flex: 1; padding: 24px; background-color: #f8fafc; }
        .navbar { background-color: #0f172a !important; }
        .navbar-brand { font-weight: 700; color: #38bdf8 !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><i class="bi bi-cash-register"></i> POS System</a>
            <div class="ms-auto d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-light small"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Logout</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <div class="d-flex flex-grow-1">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar p-2">
                <ul class="nav flex-column">
                    <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Home"?"active":"")" href="/"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <div class="section-title">Sales</div>
                    <li><a class="nav-link" asp-controller="Sale" asp-action="Create"><i class="bi bi-cash-register"></i> POS Terminal</a></li>
                    <li><a class="nav-link" asp-controller="Sale" asp-action="Index"><i class="bi bi-receipt"></i> Sales History</a></li>
                    <div class="section-title">Catalog</div>
                    <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Product"?"active":"")" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Products</a></li>
                    <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Category"?"active":"")" asp-controller="Category" asp-action="Index"><i class="bi bi-tags"></i> Categories</a></li>
                    <div class="section-title">Inventory</div>
                    <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Inventory"?"active":"")" asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes"></i> Stock Levels</a></li>
                    <li><a class="nav-link" asp-controller="Inventory" asp-action="LowStock"><i class="bi bi-exclamation-triangle"></i> Low Stock</a></li>
                    <li><a class="nav-link" asp-controller="Inventory" asp-action="PurchaseOrders"><i class="bi bi-cart-plus"></i> Purchase Orders</a></li>
                    <div class="section-title">Customers</div>
                    <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Customer"?"active":"")" asp-controller="Customer" asp-action="Index"><i class="bi bi-people"></i> Customers</a></li>
                    <div class="section-title">Reports</div>
                    <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Report"?"active":"")" asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart"></i> Reports</a></li>
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("StoreOwner"))
                    {
                        <div class="section-title">Admin</div>
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Users"><i class="bi bi-person-gear"></i> Users</a></li>
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Branches"><i class="bi bi-shop"></i> Branches</a></li>
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Settings"><i class="bi bi-gear"></i> Settings</a></li>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li><a class="nav-link" asp-controller="Admin" asp-action="Roles"><i class="bi bi-shield-lock"></i> Roles &amp; Permissions</a></li>
                        }
                    }
                    <div class="section-title">Account</div>
                    <li><a class="nav-link" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key"></i> Change Password</a></li>
                </ul>
            </div>
        }
        <main class="content-wrapper flex-grow-1">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle"></i> @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle"></i> @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
