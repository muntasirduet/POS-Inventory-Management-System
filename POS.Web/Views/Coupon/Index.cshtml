@model List<POS.Core.Entities.Coupon>
@{ ViewData["Title"] = "Coupons"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-ticket-perforated"></i> Coupons</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Coupon</a>
</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div>
}
<form class="row g-2 mb-3" method="get">
    <div class="col-auto"><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search code…" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-secondary">Search</button></div>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Code</th><th>Type</th><th>Value</th><th>Customer</th><th>Expires</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var expired = c.ExpiresAt.HasValue && c.ExpiresAt < DateTime.Now;
                    <tr>
                        <td><code class="fw-bold">@c.Code</code></td>
                        <td>@c.Type.ToString()</td>
                        <td>@(c.Type == POS.Core.Enums.DiscountType.Percentage ? $"{c.Value}%" : $"${c.Value:0.00}")</td>
                        <td>@(c.Customer?.Name ?? "Any")</td>
                        <td class="@(expired ? "text-danger" : "")">@(c.ExpiresAt?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td>
                            @if (c.IsUsed)
                            { <span class="badge bg-secondary">Used</span> }
                            else if (expired)
                            { <span class="badge bg-danger">Expired</span> }
                            else
                            { <span class="badge bg-success">Active</span> }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            @if (!c.IsUsed) {
                                <form asp-action="MarkUsed" asp-route-id="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Mark Used</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this coupon?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No coupons found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
