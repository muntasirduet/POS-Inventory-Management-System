@model POS.Web.Models.RolePermissionsViewModel
@{
    ViewData["Title"] = $"Permissions – {Model.RoleName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-key"></i> Permissions for <strong>@Model.RoleName</strong></h4>
    <a asp-action="Roles" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Roles</a>
</div>

<form asp-action="RolePermissions" asp-route-roleId="@Model.RoleId" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@Model.RoleId" />

    @foreach (var moduleGroup in Model.PermissionsByModule)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold text-uppercase small text-secondary">
                <i class="bi bi-folder2-open me-1"></i>@moduleGroup.Key
            </div>
            <div class="card-body">
                <div class="row">
                    @foreach (var perm in moduleGroup)
                    {
                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="grantedPermissionIds"
                                       value="@perm.Id"
                                       id="perm_@perm.Id"
                                       @(perm.IsGranted ? "checked" : "") />
                                <label class="form-check-label" for="perm_@perm.Id">
                                    <span class="badge bg-secondary me-1 font-monospace" style="font-size:.7rem">@perm.Name</span>
                                    @perm.Description
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mt-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Save Permissions</button>
        <a asp-action="Roles" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
