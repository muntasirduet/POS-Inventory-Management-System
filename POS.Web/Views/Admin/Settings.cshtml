@model List<POS.Core.Entities.SystemConfig>
@{ ViewData["Title"] = "System Settings"; }
<h4><i class="bi bi-gear"></i> System Settings</h4>
<div class="card shadow-sm" style="max-width:640px;">
    <div class="card-body">
        <form asp-action="Settings" method="post">
            @Html.AntiForgeryToken()
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">@Model[i].Description <small class="text-muted">(@Model[i].Key)</small></label>
                    <input type="hidden" name="configs[@i].Id" value="@Model[i].Id" />
                    <input type="hidden" name="configs[@i].Key" value="@Model[i].Key" />
                    <input type="hidden" name="configs[@i].Description" value="@Model[i].Description" />
                    <input type="text" name="configs[@i].Value" value="@Model[i].Value" class="form-control" />
                </div>
            }
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Settings</button>
        </form>
    </div>
</div>
