@model POS.Core.Entities.Branch
@{ ViewData["Title"] = "Add Branch"; }
<h2><i class="bi bi-plus-lg"></i> Add Branch</h2>
<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body">
        <form asp-action="CreateBranch" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Store</label>
                <select asp-for="StoreId" asp-items="ViewBag.Stores" class="form-select" required>
                    <option value="">-- Select Store --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Create Branch</button>
            <a asp-action="Branches" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
