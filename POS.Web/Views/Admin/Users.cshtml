@model IEnumerable<POS.Infrastructure.Identity.ApplicationUser>
@{
    ViewData["Title"] = "Users";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-people"></i> Users</h4>
    <a asp-action="CreateUser" class="btn btn-primary btn-sm"><i class="bi bi-person-plus"></i> Create User</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var roles = userRoles != null && userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var r in roles)
                            {
                                <span class="badge bg-primary me-1">@r</span>
                            }
                        </td>
                        <td>@(user.BranchId?.ToString() ?? "—")</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <a asp-action="UserPermissions" asp-route-userId="@user.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-key"></i> Permissions
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
