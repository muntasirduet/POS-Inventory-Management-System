@{
    ViewData["Title"] = "Create Role";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-shield-plus"></i> Create Role</h5></div>
            <div class="card-body">
                <form asp-action="CreateRole" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role Name</label>
                        <input name="roleName" class="form-control" required placeholder="e.g. RegionalManager" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create</button>
                        <a asp-action="Roles" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
