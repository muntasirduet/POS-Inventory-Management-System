@model POS.Web.Models.CreateUserViewModel
@{ ViewData["Title"] = "Create User"; }
<h2><i class="bi bi-person-plus"></i> Create User</h2>
<div class="card shadow-sm" style="max-width:560px;">
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Validation Errors:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        @foreach (var error in modelState.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <form asp-action="CreateUser" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" required />
                <small class="d-block text-muted mt-1">Min 8 characters, must include uppercase and digit</small>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label">Role <span class="text-danger">*</span></label>
                <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select" required>
                    <option value="">-- Select Role --</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BranchId" class="form-label">Branch (Optional)</label>
                <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                    <option value="">-- No Branch --</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Create User</button>
            <a asp-action="Users" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
