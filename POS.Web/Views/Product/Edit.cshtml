@model POS.Core.Entities.Product
@{ ViewData["Title"] = "Edit Product"; }
<h2><i class="bi bi-pencil"></i> Edit Product</h2>
<div class="card"><div class="card-body">
<form asp-action="Edit" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()
<input asp-for="Id" type="hidden"/><input asp-for="ImageUrl" type="hidden"/>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required/></div>
    <div class="col-md-3"><label asp-for="SKU" class="form-label"></label><input asp-for="SKU" class="form-control" required/></div>
    <div class="col-md-3"><label asp-for="Barcode" class="form-label"></label><input asp-for="Barcode" class="form-control"/></div>
    <div class="col-md-4"><label asp-for="Price" class="form-label"></label><div class="input-group"><span class="input-group-text">$</span><input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required/></div></div>
    <div class="col-md-4"><label class="form-label">Category</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select></div>
    <div class="col-md-4"><label class="form-label">Tax Rate</label><select asp-for="TaxRateId" asp-items="ViewBag.TaxRates" class="form-select"><option value="">-- None --</option></select></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="col-md-6"><label class="form-label">Image</label>@if(!string.IsNullOrEmpty(Model.ImageUrl)){<div class="mb-1"><img src="@Model.ImageUrl" class="img-thumbnail" style="max-height:80px"/></div>}<input type="file" name="imageFile" class="form-control" accept="image/*"/></div>
    <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" type="checkbox"/><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
</div>
<div class="mt-3"><button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save</button><a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a></div>
</form></div></div>
