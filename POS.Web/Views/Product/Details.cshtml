@model POS.Core.Entities.Product
@{ ViewData["Title"] = Model.Name; }
<h2>@Model.Name</h2>
<div class="row"><div class="col-md-4">@if(!string.IsNullOrEmpty(Model.ImageUrl)){<img src="@Model.ImageUrl" class="img-fluid rounded shadow"/>}else{<div class="bg-light text-center py-5 rounded">No Image</div>}</div>
<div class="col-md-8"><dl class="row">
    <dt class="col-4">SKU</dt><dd class="col-8"><code>@Model.SKU</code></dd>
    <dt class="col-4">Barcode</dt><dd class="col-8">@if(!string.IsNullOrEmpty(Model.Barcode)){<svg id="bcd"></svg><script>document.addEventListener('DOMContentLoaded',()=>JsBarcode("#bcd","@Model.Barcode",{width:2,height:50,displayValue:true}));</script>}</dd>
    <dt class="col-4">Price</dt><dd class="col-8">$@Model.Price.ToString("N2")</dd>
    <dt class="col-4">Category</dt><dd class="col-8">@Model.Category?.Name</dd>
    <dt class="col-4">Tax Rate</dt><dd class="col-8">@(Model.TaxRate!=null?$"{Model.TaxRate.Name} ({Model.TaxRate.Rate:P0})":"None")</dd>
    <dt class="col-4">Status</dt><dd class="col-8"><span class="badge @(Model.IsActive?"bg-success":"bg-danger")">@(Model.IsActive?"Active":"Inactive")</span></dd>
    <dt class="col-4">Description</dt><dd class="col-8">@Model.Description</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a></div></div>
