@model POS.Core.Entities.Product
@{ ViewData["Title"] = Model.Name; }
<h2>@Model.Name</h2>
<div class="row"><div class="col-md-4">@if(!string.IsNullOrEmpty(Model.ImageUrl)){<img src="@Model.ImageUrl" class="img-fluid rounded shadow"/>}else{<div class="bg-light text-center py-5 rounded">No Image</div>}</div>
<div class="col-md-8"><dl class="row">
    <dt class="col-4">SKU</dt><dd class="col-8"><code>@Model.SKU</code></dd>
    <dt class="col-4">Barcode</dt><dd class="col-8">@if(!string.IsNullOrEmpty(Model.Barcode)){<svg id="bcd"></svg><script>document.addEventListener('DOMContentLoaded',()=>JsBarcode("#bcd","@Model.Barcode",{width:2,height:50,displayValue:true}));</script>}</dd>
    <dt class="col-4">Price</dt><dd class="col-8">$@Model.Price.ToString("N2")</dd>
    <dt class="col-4">Category</dt><dd class="col-8">@Model.Category?.Name</dd>
    <dt class="col-4">Tax Rate</dt><dd class="col-8">@(Model.TaxRate!=null?$"{Model.TaxRate.Name} ({Model.TaxRate.Rate:P0})":"None")</dd>
    <dt class="col-4">Status</dt><dd class="col-8"><span class="badge @(Model.IsActive?"bg-success":"bg-danger")">@(Model.IsActive?"Active":"Inactive")</span></dd>
    <dt class="col-4">Description</dt><dd class="col-8">@Model.Description</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a></div></div>

<hr class="my-4"/>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-collection"></i> Variants</h4>
    <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#addVariantForm">
        <i class="bi bi-plus-lg"></i> Add Variant
    </button>
</div>

<div class="collapse mb-3" id="addVariantForm">
    <div class="card shadow-sm" style="max-width:600px;">
        <div class="card-body">
            <form asp-controller="Product" asp-action="AddVariant" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">SKU</label>
                        <input type="text" name="SKU" class="form-control form-control-sm" placeholder="e.g. PROD-S-RED" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Size</label>
                        <input type="text" name="Size" class="form-control form-control-sm" placeholder="S / M / L / XL" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Color</label>
                        <input type="text" name="Color" class="form-control form-control-sm" placeholder="Red / Blue …" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Price Override ($)</label>
                        <input type="number" name="Price" class="form-control form-control-sm" step="0.01" min="0" value="@Model.Price" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stock Qty</label>
                        <input type="number" name="StockQty" class="form-control form-control-sm" min="0" value="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Barcode</label>
                        <input type="text" name="Barcode" class="form-control form-control-sm" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm mt-2"><i class="bi bi-save"></i> Save Variant</button>
            </form>
        </div>
    </div>
</div>

@if (Model.Variants != null && Model.Variants.Any())
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>SKU</th>
                        <th>Size</th>
                        <th>Color</th>
                        <th>Weight</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Stock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Variants)
                    {
                        <tr>
                            <td><code>@v.SKU</code></td>
                            <td>@(v.Size ?? "—")</td>
                            <td>@(v.Color ?? "—")</td>
                            <td>@(v.Weight ?? "—")</td>
                            <td class="text-end">$@v.Price.ToString("N2")</td>
                            <td class="text-end">@v.StockQty</td>
                            <td>
                                <form asp-controller="Product" asp-action="DeleteVariant" asp-route-id="@v.Id" asp-route-productId="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Remove variant?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <p class="text-muted">No variants defined for this product.</p>
}
