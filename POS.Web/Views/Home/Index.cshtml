@model POS.Application.DTOs.DashboardDto
@{ ViewData["Title"] = "Dashboard"; var labels = Model.DailySales.Select(d => d.Date).ToArray(); var data = Model.DailySales.Select(d => d.Total).ToArray(); }

@if (User.IsInRole("Cashier"))
{
    <h2><i class="bi bi-cash-register"></i> POS Terminal</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a asp-controller="Sale" asp-action="Create" class="card text-white bg-success shadow-sm text-decoration-none d-block">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div><div class="fw-bold fs-5">New Sale</div><div class="small">Open POS Terminal</div></div>
                    <i class="bi bi-cash-register fs-1 opacity-75"></i>
                </div>
            </a>
        </div>
        <div class="col-md-4"><div class="card text-white bg-primary shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Today Transactions</div><div class="fs-4 fw-bold">@Model.TodayTransactions</div></div><i class="bi bi-receipt fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-4"><div class="card text-white bg-info shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Today Revenue</div><div class="fs-4 fw-bold">$@Model.TodayRevenue.ToString("N2")</div></div><i class="bi bi-currency-dollar fs-1 opacity-50"></i></div></div></div>
    </div>
    <div class="row g-3">
        <div class="col-12"><div class="card shadow-sm"><div class="card-header"><strong>Quick Actions</strong></div><div class="card-body d-flex gap-2">
            <a asp-controller="Sale" asp-action="Create" class="btn btn-success"><i class="bi bi-cash-register"></i> New Sale</a>
            <a asp-controller="Sale" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-receipt"></i> Sales History</a>
            <a asp-controller="Customer" asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-person-plus"></i> Add Customer</a>
        </div></div></div>
    </div>
}
else if (User.IsInRole("Accountant"))
{
    <h2><i class="bi bi-calculator"></i> Accountant Dashboard</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card text-white bg-success shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Today Revenue</div><div class="fs-4 fw-bold">$@Model.TodayRevenue.ToString("N2")</div></div><i class="bi bi-currency-dollar fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-primary shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Today Transactions</div><div class="fs-4 fw-bold">@Model.TodayTransactions</div></div><i class="bi bi-receipt fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-info shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Avg Order</div><div class="fs-4 fw-bold">$@Model.AvgOrderValue.ToString("N2")</div></div><i class="bi bi-graph-up fs-1 opacity-50"></i></div></div></div>
    </div>
    <div class="row g-3">
        <div class="col-12"><div class="card shadow-sm"><div class="card-header"><strong>Reports</strong></div><div class="card-body d-flex gap-2 flex-wrap">
            <a asp-controller="Report" asp-action="Sales" class="btn btn-success"><i class="bi bi-bar-chart"></i> Sales Report</a>
            <a asp-controller="Report" asp-action="Inventory" class="btn btn-primary"><i class="bi bi-boxes"></i> Inventory Report</a>
            <a asp-controller="Report" asp-action="AuditLogs" class="btn btn-warning"><i class="bi bi-shield-check"></i> Audit Logs</a>
        </div></div></div>
    </div>
}
else if (User.IsInRole("InventoryManager"))
{
    <h2><i class="bi bi-boxes"></i> Inventory Dashboard</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card text-white bg-warning shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Low Stock Alerts</div><div class="fs-4 fw-bold">@Model.LowStockItems.Count</div></div><i class="bi bi-exclamation-triangle fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-4"><div class="card text-white bg-primary shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Active Products</div><div class="fs-4 fw-bold">@Model.ActiveProducts</div></div><i class="bi bi-box-seam fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-4"><div class="card text-white bg-info shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Pending Purchase Orders</div><div class="fs-4 fw-bold">@Model.PendingPurchaseOrders</div></div><i class="bi bi-cart-plus fs-1 opacity-50"></i></div></div></div>
    </div>
    <div class="row g-3">
        <div class="col-md-8"><div class="card shadow-sm border-warning"><div class="card-header bg-warning"><strong><i class="bi bi-exclamation-triangle"></i> Low Stock Alerts</strong></div><div class="card-body p-0">
            @if (!Model.LowStockItems.Any()) { <p class="text-muted p-3 mb-0">All stock levels OK ✓</p> }
            else { <ul class="list-group list-group-flush">@foreach(var item in Model.LowStockItems){<li class="list-group-item d-flex justify-content-between align-items-center"><div><small class="fw-bold">@item.ProductName</small><br/><small class="text-muted">@item.BranchName</small></div><span class="badge bg-danger rounded-pill">@item.QtyOnHand left</span></li>}</ul> }
        </div></div></div>
        <div class="col-md-4"><div class="card shadow-sm"><div class="card-header"><strong>Quick Actions</strong></div><div class="card-body d-flex flex-column gap-2">
            <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-boxes"></i> Stock Levels</a>
            <a asp-controller="Inventory" asp-action="Adjust" class="btn btn-outline-warning"><i class="bi bi-sliders"></i> Adjust Stock</a>
            <a asp-controller="Inventory" asp-action="CreatePurchaseOrder" class="btn btn-outline-success"><i class="bi bi-cart-plus"></i> New Purchase Order</a>
        </div></div></div>
    </div>
}
else
{
    @* StoreOwner / StoreManager / SuperAdmin *@
    <h2><i class="bi bi-speedometer2"></i> Dashboard</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card text-white bg-success shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Today Revenue</div><div class="fs-4 fw-bold">$@Model.TodayRevenue.ToString("N2")</div></div><i class="bi bi-currency-dollar fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-primary shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Transactions</div><div class="fs-4 fw-bold">@Model.TodayTransactions</div></div><i class="bi bi-receipt fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-info shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Active Products</div><div class="fs-4 fw-bold">@Model.ActiveProducts</div></div><i class="bi bi-box-seam fs-1 opacity-50"></i></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-warning shadow-sm"><div class="card-body d-flex justify-content-between"><div><div class="small">Low Stock Items</div><div class="fw-bold fs-4">@Model.LowStockItems.Count</div></div><i class="bi bi-exclamation-triangle fs-1 opacity-50"></i></div></div></div>
    </div>
    <div class="row g-3">
        <div class="col-md-8"><div class="card shadow-sm"><div class="card-header"><strong><i class="bi bi-graph-up"></i> Sales Trend (30 Days)</strong></div><div class="card-body"><canvas id="salesChart" height="100"></canvas></div></div></div>
        <div class="col-md-4"><div class="card shadow-sm border-warning"><div class="card-header bg-warning"><strong><i class="bi bi-exclamation-triangle"></i> Low Stock Alerts</strong></div><div class="card-body p-0">
            @if (!Model.LowStockItems.Any()) { <p class="text-muted p-3 mb-0">All stock levels OK ✓</p> }
            else { <ul class="list-group list-group-flush">@foreach(var item in Model.LowStockItems){<li class="list-group-item d-flex justify-content-between align-items-center"><div><small class="fw-bold">@item.ProductName</small><br/><small class="text-muted">@item.BranchName</small></div><span class="badge bg-danger rounded-pill">@item.QtyOnHand left</span></li>}</ul><div class="p-2"><a asp-controller="Inventory" asp-action="LowStock" class="btn btn-warning btn-sm w-100">View All</a></div> }
        </div></div></div>
    </div>
    <div class="row g-3 mt-1"><div class="col-12"><div class="card shadow-sm"><div class="card-header"><strong>Quick Actions</strong></div><div class="card-body d-flex gap-2 flex-wrap">
        <a asp-controller="Sale" asp-action="Create" class="btn btn-success"><i class="bi bi-cash-register"></i> New Sale</a>
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Product</a>
        <a asp-controller="Customer" asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-person-plus"></i> Add Customer</a>
        <a asp-controller="Report" asp-action="Sales" class="btn btn-outline-secondary"><i class="bi bi-bar-chart"></i> Sales Report</a>
        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-warning"><i class="bi bi-boxes"></i> Check Stock</a>
        @if (Model.PendingPurchaseOrders > 0)
        {
            <a asp-controller="Inventory" asp-action="PurchaseOrders" class="btn btn-outline-info"><i class="bi bi-cart-plus"></i> Purchase Orders <span class="badge bg-info">@Model.PendingPurchaseOrders</span></a>
        }
    </div></div></div></div>
    @section Scripts {
    <script>
    new Chart(document.getElementById('salesChart').getContext('2d'),{type:'line',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),datasets:[{label:'Revenue ($)',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(data)),backgroundColor:'rgba(59,130,246,0.1)',borderColor:'rgba(59,130,246,1)',borderWidth:2,tension:0.4,fill:true,pointRadius:3}]},options:{responsive:true,scales:{y:{beginAtZero:true,ticks:{callback:v=>'$'+v}}},plugins:{legend:{display:false}}}});
    </script>}
}
