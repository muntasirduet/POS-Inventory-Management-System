@model List<POS.Core.Entities.Category>
@{ ViewData["Title"] = "Categories"; }
<div class="d-flex justify-content-between mb-3"><h2><i class="bi bi-tags"></i> Categories</h2><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add</a></div>
<div class="card"><div class="card-body"><table class="table table-hover"><thead class="table-dark"><tr><th>Name</th><th>Parent</th><th>Actions</th></tr></thead><tbody>
@foreach(var c in Model){<tr><td>@c.Name</td><td>@(c.ParentCategory?.Name??"—")</td><td>
<a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
<form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline" onsubmit="return confirm('Delete?')">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>
</td></tr>}
</tbody></table></div></div>
