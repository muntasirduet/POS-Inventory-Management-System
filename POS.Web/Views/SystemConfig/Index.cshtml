@model Dictionary<string, List<POS.Core.Entities.SystemConfig>>
@{ ViewData["Title"] = "System Configuration"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-gear-fill"></i> System Configuration</h2>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row g-4">
@foreach (var group in Model)
{
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light"><strong><i class="bi bi-sliders"></i> @group.Key</strong></div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light"><tr><th>Key</th><th>Value</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                    @foreach (var cfg in group.Value)
                    {
                        <tr>
                            <td class="align-middle">
                                <div class="fw-semibold">@cfg.Key</div>
                                @if (!string.IsNullOrWhiteSpace(cfg.Description))
                                { <div class="text-muted small">@cfg.Description</div> }
                            </td>
                            <td class="align-middle" style="min-width:160px">
                                <form asp-action="Update" method="post" class="d-flex gap-1 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@cfg.Id" />
                                    <input type="text" name="value" value="@cfg.Value" class="form-control form-control-sm" style="min-width:100px" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Save"><i class="bi bi-check-lg"></i></button>
                                </form>
                            </td>
                            <td></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
</div>
