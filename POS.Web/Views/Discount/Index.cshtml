@model List<POS.Core.Entities.Discount>
@{ ViewData["Title"] = "Scheduled Discounts"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-percent"></i> Scheduled Discounts</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Discount</a>
</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div>
}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Type</th><th>Value</th><th>Category</th><th>Start</th><th>End</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var now = DateTime.Now;
                    var live = d.IsActive && (d.StartDate == null || d.StartDate <= now) && (d.EndDate == null || d.EndDate >= now);
                    <tr>
                        <td><strong>@d.Name</strong></td>
                        <td>@d.Type.ToString()</td>
                        <td>@(d.Type == POS.Core.Enums.DiscountType.Percentage ? $"{d.Value}%" : $"${d.Value:0.00}")</td>
                        <td>@(d.Category?.Name ?? "<em>All</em>")</td>
                        <td>@(d.StartDate?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td>@(d.EndDate?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td>
                            @if (!d.IsActive) { <span class="badge bg-secondary">Disabled</span> }
                            else if (live) { <span class="badge bg-success">Live</span> }
                            else { <span class="badge bg-warning text-dark">Scheduled</span> }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@d.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(d.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    @(d.IsActive ? "Disable" : "Enable")
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this discount?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No discounts defined.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
