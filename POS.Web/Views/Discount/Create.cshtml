@model POS.Core.Entities.Discount
@{ ViewData["Title"] = "New Discount"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-percent"></i> New Discount</h4>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card" style="max-width:520px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label">Type</label>
                    <select asp-for="Type" class="form-select"
                            asp-items="@Html.GetEnumSelectList<POS.Core.Enums.DiscountType>()"></select>
                </div>
                <div class="col-6">
                    <label class="form-label">Value</label>
                    <input asp-for="Value" type="number" step="0.01" min="0" class="form-control" required />
                    <small class="text-muted">% for Percentage, $ for Fixed</small>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Apply to Category (leave blank = all products)</label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var c in ViewBag.Categories as List<POS.Core.Entities.Category> ?? new())
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label">Start Date (optional)</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" />
                </div>
                <div class="col-6">
                    <label class="form-label">End Date (optional)</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
