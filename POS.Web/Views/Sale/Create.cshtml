@{ ViewData["Title"] = "POS Terminal"; }
<style>
    .product-tile { transition: transform .15s, box-shadow .15s; }
    .product-tile:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.12)!important; }
    .attribute-group { margin-bottom: 1rem; }
    .attribute-checkbox { margin-right: 1.5rem; }
    .branch-warning { background-color: #fff3cd; border-left: 4px solid #ffc107; }
</style>

<div class="row g-0" style="height:calc(100vh - 80px)">
    <!-- Left Panel: Products -->
    <div class="col-lg-7 border-end d-flex flex-column" style="height:calc(100vh - 80px)">
        <div class="p-2 border-bottom">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                <input type="text" id="barcodeInput" class="form-control" placeholder="Scan barcode or search..." autofocus />
                <button class="btn btn-primary" onclick="searchProduct()"><i class="bi bi-search"></i></button>
                <button class="btn btn-outline-secondary" onclick="clearSearch()" title="Clear"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>

        <!-- Categories -->
        <div class="px-2 py-1 border-bottom bg-white overflow-auto" style="white-space:nowrap;flex-shrink:0">
            <button class="btn btn-sm btn-primary me-1 mb-1 cat-btn active" data-cat="0" onclick="filterCategory(0,this)"><i class="bi bi-grid-3x3-gap-fill"></i> All</button>
            <span id="catTabs"></span>
        </div>

        <!-- Products Grid -->
        <div class="flex-grow-1 overflow-auto p-2">
            <div class="row g-2" id="productGridInner"></div>
        </div>
    </div>

    <!-- Right Panel: Cart -->
    <div class="col-lg-5 d-flex flex-column bg-light">
        <!-- Cart Header with Customer Search -->
        <div class="p-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <h5 class="mb-0"><i class="bi bi-cart3"></i> Cart</h5>
                <span class="badge bg-info">Branch: <span id="branchBadge"></span></span>
            </div>
            <div class="position-relative">
                <input type="text" id="customerSearch" class="form-control form-control-sm" placeholder="Search customer..." autocomplete="off" oninput="searchCustomerLive(this.value)" />
                <input type="hidden" id="selectedCustomerId" />
                <div id="customerDropdown" class="list-group shadow position-absolute start-0 top-100 w-100 d-none" style="z-index:1000;max-height:200px;overflow-y:auto"></div>
            </div>
            <div id="customerBadgeContainer" class="mt-2 d-none">
                <span id="selectedCustomerBadge" class="badge bg-primary"></span>
                <button class="btn btn-sm btn-close" onclick="clearCustomer()" title="Clear"></button>
            </div>
        </div>

        <!-- Cart Items -->
        <div id="cartItems" class="flex-grow-1 overflow-auto p-3"></div>

        <!-- Order Summary -->
        <div class="p-3 border-top bg-white">
            <div class="row mb-2 small">
                <div class="col-6">Subtotal:</div>
                <div class="col-6 text-end fw-bold" id="subtotal">$0.00</div>
                <div class="col-6">Tax:</div>
                <div class="col-6 text-end" id="taxDisplay">$0.00</div>
                <div class="col-6">Discount:</div>
                <div class="col-6 text-end">
                    <input type="number" id="discountInput" class="form-control form-control-sm text-end" value="0" min="0" step="0.01" style="width:100px;display:inline-block" onchange="updateTotals()" />
                </div>
                <div class="col-6"><strong>TOTAL:</strong></div>
                <div class="col-6 text-end fs-5 fw-bold text-success" id="totalDisplay">$0.00</div>
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-success btn-lg" onclick="openPayment()"><i class="bi bi-credit-card"></i> Pay</button>
                <div class="row g-2">
                    <div class="col-6"><button class="btn btn-warning w-100" onclick="holdSale()"><i class="bi bi-pause-circle"></i> Hold</button></div>
                    <div class="col-6"><button class="btn btn-outline-secondary w-100" onclick="loadHeld()"><i class="bi bi-arrow-clockwise"></i> Recall</button></div>
                </div>
                <button class="btn btn-outline-danger btn-sm" onclick="clearCart()">Clear Cart</button>
            </div>
        </div>
    </div>
</div>

<!-- Product Attributes Modal -->
<div class="modal fade" id="attributeModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-collection me-1"></i> Select Attributes</h5>
                <small class="text-muted ms-2" id="attrModalProductName"></small>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="attributeModalBody">
                <div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm"></div> Loading...</div>
            </div>
            <div class="modal-footer">
                <input type="number" id="attrQuantity" class="form-control form-control-sm" value="1" min="1" style="width:80px" />
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="addProductWithAttributes()">Add to Cart</button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Process Payment</h5></div>
            <div class="modal-body">
                <p>Total: <strong id="modalTotal" class="text-success fs-4">$0.00</strong></p>
                <div class="mb-3">
                    <label class="form-label">Method</label>
                    <select id="payMethod" class="form-select" onchange="onMethodChange()">
                        <option value="0">Cash</option>
                        <option value="1">Card</option>
                        <option value="2">Mobile Wallet</option>
                        <option value="3">QR</option>
                        <option value="4">Gift Card</option>
                        <option value="5">Store Credit</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Amount</label>
                    <input type="number" id="payAmount" class="form-control" step="0.01" oninput="calcChange()" />
                </div>
                <div id="changeRow" class="mb-3">
                    <label class="form-label">Change</label>
                    <input type="text" id="changeDisplay" class="form-control" readonly />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" onclick="completeSale()"><i class="bi bi-check-lg"></i> Complete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ============ CART PERSISTENCE ============
const CART_STORAGE_KEY = 'pos_cart_' + (new Date()).toISOString().split('T')[0];
let cart = [];
let allProducts = [];
let currentProductForAttributes = null;
const branchId = @(ViewBag.BranchId ?? 0);

// Load cart from localStorage on page load
window.addEventListener('load', () => {
    document.getElementById('branchBadge').textContent = branchId || 'Not Set';
    if (branchId <= 0) {
        // Show notification instead of alert
        const productGrid = document.getElementById('productGridInner');
        productGrid.innerHTML = `
            <div class="col-12">
                <div class="alert alert-warning alert-dismissible fade show mb-0" role="alert">
                    <h5><i class="bi bi-exclamation-triangle-fill"></i> Branch Not Selected</h5>
                    <p class="mb-2">Please select your working branch from the <strong>Branch selector</strong> in the top navbar (left of your name).</p>
                    <hr>
                    <p class="mb-0"><small>Once you select a branch, you'll be able to start accepting sales. The branch selector will remember your selection.</small></p>
                </div>
            </div>
        `;
        document.getElementById('cartItems').innerHTML = '<div class="text-center text-muted py-5"><i class="bi bi-info-circle"></i> Select a branch to continue</div>';
        // Disable main buttons
        document.querySelectorAll('button[onclick="openPayment()"], button[onclick="holdSale()"], button[onclick="loadHeld()"]').forEach(btn => btn.disabled = true);
        return;
    }
    loadCartFromStorage();
    loadProducts();
    loadCategories();
});

// ============ CART STORAGE FUNCTIONS ============
function saveCartToStorage() {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
}

function loadCartFromStorage() {
    const saved = localStorage.getItem(CART_STORAGE_KEY);
    if (saved) {
        try {
            cart = JSON.parse(saved);
            renderCart();
            updateTotals();
        } catch (e) {
            console.error('Failed to load cart from storage:', e);
            cart = [];
        }
    }
}

// ============ PRODUCT LOADING ============
async function loadProducts() {
    try {
        const response = await fetch('/Sale/GetProductsForBranch');
        const data = await response.json();
        allProducts = data;
        renderProductGrid('');
    } catch (error) {
        console.error('Failed to load products:', error);
        showToast('Failed to load products', 'danger');
    }
}

async function loadCategories() {
    const categories = [...new Set(allProducts.map(p => p.category))].filter(c => c);
    const tabs = document.getElementById('catTabs');
    tabs.innerHTML = categories.map((cat, idx) =>
        `<button class="btn btn-sm btn-outline-primary me-1 mb-1 cat-btn" data-cat="${cat}" onclick="filterCategory('${cat}',this)"><i class="bi bi-tag"></i> ${cat}</button>`
    ).join('');
}

function filterCategory(cat, button) {
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    button.classList.add('active');
    renderProductGrid(document.getElementById('barcodeInput').value.trim(), cat === 0 ? null : cat);
}

function renderProductGrid(search = '', category = null) {
    let filtered = allProducts;
    
    if (category) {
        filtered = filtered.filter(p => p.category === category);
    }

    if (search) {
        const q = search.toLowerCase();
        filtered = filtered.filter(p =>
            p.name.toLowerCase().includes(q) ||
            p.sku.toLowerCase().includes(q) ||
            (p.barcode && p.barcode.includes(q))
        );
    }

    const grid = document.getElementById('productGridInner');
    grid.innerHTML = filtered.map(p => `
        <div class="col-6 col-sm-4 col-md-3">
            <div class="card product-tile h-100 cursor-pointer" onclick="selectProduct(${p.id})">
                <img src="${p.imageUrl || 'https://via.placeholder.com/150?text=' + encodeURIComponent(p.name.substring(0, 15))}" class="card-img-top" style="height:120px;object-fit:cover" alt="${p.name}">
                <div class="card-body p-2">
                    <small class="card-title text-truncate d-block"><strong>${p.name}</strong></small>
                    <small class="text-muted d-block">${p.sku}</small>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-success">$${p.price.toFixed(2)}</span>
                        ${p.hasVariants ? `<span class="badge bg-secondary text-white">${p.variantCount} variants</span>` : ''}
                    </div>
                </div>
            </div>
        </div>
    `).join('');
}

// ============ PRODUCT SELECTION & ATTRIBUTES ============
async function selectProduct(productId) {
    const product = allProducts.find(p => p.id === productId);
    if (!product) return;

    try {
        const response = await fetch(`/Sale/GetProductAttributes?productId=${productId}`);
        const data = await response.json();

        if (!data.success) {
            showToast(data.message || 'Product not found', 'danger');
            return;
        }

        currentProductForAttributes = data.product;
        renderAttributeSelector(data.product);

        const modal = new bootstrap.Modal(document.getElementById('attributeModal'));
        modal.show();
    } catch (error) {
        console.error('Failed to load product attributes:', error);
        showToast('Failed to load attributes', 'danger');
    }
}

function renderAttributeSelector(product) {
    document.getElementById('attrModalProductName').textContent = product.name;
    document.getElementById('attrQuantity').value = 1;

    const body = document.getElementById('attributeModalBody');
    
    if (!product.attributes || product.attributes.length === 0) {
        body.innerHTML = `
            <div class="alert alert-info">
                <strong>${product.name}</strong><br>
                Price: <span class="fs-5 text-success">$${product.price.toFixed(2)}</span><br>
                This product has no attributes to select.
            </div>
        `;
        return;
    }

    body.innerHTML = product.attributes.map(attr => `
        <div class="attribute-group">
            <h6 class="mb-2"><strong>${attr.name}</strong></h6>
            <div>
                ${attr.values.map(val => `
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="attr_${attr.name}_${val}" value="${val}" data-attr="${attr.name}">
                        <label class="form-check-label" for="attr_${attr.name}_${val}">${val}</label>
                    </div>
                `).join('')}
            </div>
        </div>
    `).join('');
}

function addProductWithAttributes() {
    if (!currentProductForAttributes) return;

    const qty = parseInt(document.getElementById('attrQuantity').value) || 1;
    const product = currentProductForAttributes;
    
    // Collect selected attributes
    const selectedAttrs = {};
    document.querySelectorAll('#attributeModalBody .form-check-input:checked').forEach(checkbox => {
        const attrName = checkbox.dataset.attr;
        const value = checkbox.value;
        if (!selectedAttrs[attrName]) selectedAttrs[attrName] = [];
        selectedAttrs[attrName].push(value);
    });

    // Create cart item
    const cartItem = {
        productId: product.id,
        productName: product.name,
        unitPrice: product.price,
        qty: qty,
        discount: 0,
        selectedAttributes: selectedAttrs,
        sku: null
    };

    // Add to cart
    const existingItem = cart.find(item =>
        item.productId === cartItem.productId &&
        JSON.stringify(item.selectedAttributes) === JSON.stringify(cartItem.selectedAttributes)
    );

    if (existingItem) {
        existingItem.qty += qty;
    } else {
        cart.push(cartItem);
    }

    saveCartToStorage();
    renderCart();
    updateTotals();

    // Close modal
    bootstrap.Modal.getInstance(document.getElementById('attributeModal')).hide();
    document.getElementById('barcodeInput').focus();
    showToast(`✓ Added ${product.name} to cart`, 'success');
}

// ============ CART RENDERING ============
function renderCart() {
    const container = document.getElementById('cartItems');
    
    if (cart.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-5">Cart is empty</div>';
        return;
    }

    container.innerHTML = cart.map((item, idx) => `
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <div>
                        <strong class="d-block">${item.productName}</strong>
                        <small class="text-muted">$${item.unitPrice.toFixed(2)} × ${item.qty}</small>
                    </div>
                    <button class="btn btn-sm btn-close" onclick="removeCartItem(${idx})"></button>
                </div>
                ${Object.keys(item.selectedAttributes || {}).length > 0 ? `
                    <small class="text-secondary d-block mb-1">
                        ${Object.entries(item.selectedAttributes).map(([attr, vals]) => `<strong>${attr}:</strong> ${vals.join(', ')}`).join(' | ')}
                    </small>
                ` : ''}
                <div class="input-group input-group-sm">
                    <button class="btn btn-outline-secondary" onclick="updateCartQty(${idx}, ${item.qty - 1})">-</button>
                    <input type="text" class="form-control text-center" value="${item.qty}" readonly style="width:50px">
                    <button class="btn btn-outline-secondary" onclick="updateCartQty(${idx}, ${item.qty + 1})">+</button>
                    <input type="number" class="form-control text-end" placeholder="Disc" value="${item.discount}" onchange="updateCartDiscount(${idx}, this.value)" style="width:70px">
                </div>
            </div>
        </div>
    `).join('');
}

function removeCartItem(index) {
    cart.splice(index, 1);
    saveCartToStorage();
    renderCart();
    updateTotals();
}

function updateCartQty(index, newQty) {
    if (newQty < 1) return;
    cart[index].qty = newQty;
    saveCartToStorage();
    renderCart();
    updateTotals();
}

function updateCartDiscount(index, discount) {
    cart[index].discount = parseFloat(discount) || 0;
    saveCartToStorage();
    updateTotals();
}

// ============ TOTALS & CHECKOUT ============
function updateTotals() {
    const subtotal = cart.reduce((sum, item) => sum + (item.unitPrice * item.qty), 0);
    const manualDiscount = parseFloat(document.getElementById('discountInput').value) || 0;
    const tax = (subtotal - manualDiscount) * 0.1; // Assuming 10% tax
    const total = subtotal - manualDiscount + tax;

    document.getElementById('subtotal').textContent = '$' + subtotal.toFixed(2);
    document.getElementById('taxDisplay').textContent = '$' + tax.toFixed(2);
    document.getElementById('totalDisplay').textContent = '$' + total.toFixed(2);
    document.getElementById('modalTotal').textContent = '$' + total.toFixed(2);
}

function clearCart() {
    if (!confirm('Clear cart?')) return;
    cart = [];
    saveCartToStorage();
    renderCart();
    updateTotals();
    clearCustomer();
}

function clearSearch() {
    document.getElementById('barcodeInput').value = '';
    renderProductGrid('');
}

function searchProduct() {
    const q = document.getElementById('barcodeInput').value.trim();
    if (!q) return;
    renderProductGrid(q);
}

// ============ CUSTOMER SEARCH ============
async function searchCustomerLive(q) {
    const dd = document.getElementById('customerDropdown');
    if (q.length < 2) { dd.classList.add('d-none'); return; }
    
    try {
        const r = await fetch('/Sale/SearchCustomer?q=' + encodeURIComponent(q));
        const list = await r.json();
        if (!list.length) {
            dd.innerHTML = '<span class="list-group-item py-1 text-muted small">No results</span>';
            dd.classList.remove('d-none');
            return;
        }
        dd.innerHTML = list.map(c => `
            <button class="list-group-item list-group-item-action py-1 px-2 small" onclick="selectCustomer(${c.id},'${c.name.replace(/'/g,"&#39;")}','${(c.phone||'').replace(/'/g,"&#39;")}')">
                <strong>${c.name}</strong> ${c.phone ? `• ${c.phone}` : ''}
            </button>
        `).join('');
        dd.classList.remove('d-none');
    } catch (e) { dd.classList.add('d-none'); }
}

function selectCustomer(id, name, phone) {
    document.getElementById('selectedCustomerId').value = id;
    document.getElementById('customerSearch').value = '';
    document.getElementById('selectedCustomerBadge').textContent = name + (phone ? ` (${phone})` : '');
    document.getElementById('customerBadgeContainer').classList.remove('d-none');
    document.getElementById('customerDropdown').classList.add('d-none');
}

function clearCustomer() {
    document.getElementById('selectedCustomerId').value = '';
    document.getElementById('customerSearch').value = '';
    document.getElementById('customerBadgeContainer').classList.add('d-none');
    document.getElementById('customerDropdown').classList.add('d-none');
}

// ============ PAYMENT ============
function openPayment() {
    if (cart.length === 0) {
        alert('Cart is empty');
        return;
    }
    new bootstrap.Modal(document.getElementById('paymentModal')).show();
}

function onMethodChange() {
    const method = document.getElementById('payMethod').value;
    document.getElementById('changeRow').style.display = method === '0' ? 'block' : 'none';
}

function calcChange() {
    const total = cart.reduce((sum, item) => sum + (item.unitPrice * item.qty), 0);
    const amount = parseFloat(document.getElementById('payAmount').value) || 0;
    document.getElementById('changeDisplay').value = '$' + Math.max(0, amount - total).toFixed(2);
}

async function completeSale() {
    if (cart.length === 0) {
        alert('Cart is empty');
        return;
    }

    try {
        const response = await fetch('/Sale/Complete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({
                items: cart,
                payments: [{
                    method: parseInt(document.getElementById('payMethod').value),
                    amount: parseFloat(document.getElementById('payAmount').value) || 0
                }],
                customerId: parseInt(document.getElementById('selectedCustomerId').value) || null,
                branchId: branchId,
                discount: parseFloat(document.getElementById('discountInput').value) || 0,
                couponCode: null
            })
        });

        const data = await response.json();
        if (data.success) {
            cart = [];
            saveCartToStorage();
            clearCustomer();
            showToast('✓ Sale completed!', 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            alert('Error: ' + (data.message || 'Sale failed'));
        }
    } catch (error) {
        console.error('Failed to complete sale:', error);
        alert('Error completing sale');
    }
}

async function holdSale() {
    if (cart.length === 0) {
        alert('Cart is empty');
        return;
    }
    const label = prompt('Hold label (e.g., Customer Name):');
    if (!label) return;

    try {
        const response = await fetch('/Sale/Hold', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({
                items: cart,
                customerId: parseInt(document.getElementById('selectedCustomerId').value) || null,
                branchId: branchId,
                holdLabel: label,
                holdNotes: '',
                couponCode: null,
                manualDiscount: parseFloat(document.getElementById('discountInput').value) || 0
            })
        });

        const data = await response.json();
        if (data.success) {
            cart = [];
            saveCartToStorage();
            renderCart();
            updateTotals();
            showToast('✓ Sale held successfully!', 'success');
        } else {
            alert('Error: ' + (data.message || 'Hold failed'));
        }
    } catch (error) {
        console.error('Failed to hold sale:', error);
        alert('Error holding sale');
    }
}

async function loadHeld() {
    // TODO: Implement held sales recall
    showToast('Recall feature coming soon', 'info');
}

function showToast(text, type) {
    let c = document.getElementById('toastContainer');
    if (!c) {
        c = document.createElement('div');
        c.id = 'toastContainer';
        c.className = 'position-fixed bottom-0 end-0 p-3';
        c.style.zIndex = '9999';
        document.body.appendChild(c);
    }
    const t = document.createElement('div');
    t.className = `toast align-items-center text-bg-${type || 'success'} border-0`;
    t.innerHTML = `<div class="d-flex"><div class="toast-body">${text}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
    c.appendChild(t);
    const bt = new bootstrap.Toast(t, { delay: 3000 });
    bt.show();
    t.addEventListener('hidden.bs.toast', () => t.remove());
}

// Close customer dropdown on outside click
document.addEventListener('click', e => {
    if (!e.target.closest('#customerSearch') && !e.target.closest('#customerDropdown'))
        document.getElementById('customerDropdown').classList.add('d-none');
});
</script>
}
