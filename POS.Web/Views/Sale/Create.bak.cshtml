@{ ViewData["Title"] = "POS Terminal"; }
<style>.product-tile{transition:transform .15s,box-shadow .15s}.product-tile:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.12)!important}</style>
<div class="row g-0" style="height:calc(100vh - 80px)">
<div class="col-md-7 border-end d-flex flex-column" style="height:calc(100vh - 80px)">
    <div class="p-2 border-bottom">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
            <input type="text" id="barcodeInput" class="form-control" placeholder="Scan barcode or type to search…" autofocus />
            <button class="btn btn-primary" onclick="searchProduct()"><i class="bi bi-search"></i></button>
            <button class="btn btn-outline-secondary" onclick="clearSearch()" title="Clear"><i class="bi bi-x-lg"></i></button>
        </div>
    </div>
    <div class="px-2 py-1 border-bottom bg-white overflow-auto" style="white-space:nowrap;flex-shrink:0">
        <button class="btn btn-sm btn-primary me-1 mb-1 cat-btn active" data-cat="0" onclick="filterCategory(0,this)"><i class="bi bi-grid-3x3-gap-fill"></i> All</button>
        <span id="catTabs"></span>
    </div>
    <div class="flex-grow-1 overflow-auto p-2">
        <div class="row g-2" id="productGridInner"></div>
    </div>
</div>
<div class="col-md-5 d-flex flex-column bg-light">
    <div class="p-3 border-bottom"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><h5 class="mb-0"><i class="bi bi-cart3"></i> Cart</h5>
    <div class="d-flex align-items-center gap-1">
      <div class="position-relative">
        <input type="text" id="customerSearch" class="form-control form-control-sm" placeholder="Search customer / phone…" style="width:200px" oninput="searchCustomerLive(this.value)" autocomplete="off">
        <input type="hidden" id="selectedCustomerId">
        <div id="customerDropdown" class="list-group shadow position-absolute start-0 top-100 w-100 d-none" style="z-index:1000;max-height:200px;overflow-y:auto"></div>
      </div>
      <span id="selectedCustomerBadge" class="badge bg-primary d-none" style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
      <button class="btn btn-sm btn-outline-secondary py-0" title="Clear customer" onclick="clearCustomer()" id="clearCustomerBtn" style="display:none"><i class="bi bi-x-circle"></i></button>
    </div></div></div>
    <div id="cartItems" class="flex-grow-1 overflow-auto p-3"></div>
    <div class="p-3 border-top bg-white">
        <div class="row mb-2">
            <div class="col-6">Subtotal:</div><div class="col-6 text-end fw-bold" id="subtotal">$0.00</div>
            <div class="col-6">Tax:</div><div class="col-6 text-end" id="taxDisplay">$0.00</div>
            <div class="col-6">Discount:</div><div class="col-6 text-end"><input type="number" id="discountInput" class="form-control form-control-sm text-end" value="0" min="0" step="0.01" style="width:100px;display:inline-block" onchange="updateTotals()"/></div>
            <div class="col-6"><strong>TOTAL:</strong></div><div class="col-6 text-end fs-4 fw-bold text-success" id="totalDisplay">$0.00</div>
        </div>
        <div class="mb-2"><div class="input-group input-group-sm"><input type="text" id="couponCode" class="form-control" placeholder="Coupon code"/><button class="btn btn-outline-secondary" onclick="applyCoupon()">Apply</button></div><small id="couponMsg" class="text-muted"></small></div>
        <div id="loyaltyPanel" class="mb-2 d-none"><div class="d-flex justify-content-between align-items-center mb-1"><small class="text-primary fw-bold"><i class="bi bi-star-fill"></i> Loyalty: <span id="loyaltyPoints">0</span> pts (<span id="loyaltyTier"></span>)</small><button class="btn btn-outline-primary btn-sm py-0" onclick="toggleRewards()">Rewards</button></div><div id="rewardsListPanel" class="d-none"><div id="rewardsList"></div><small id="rewardMsg" class="text-muted"></small></div></div>
        <div class="d-grid gap-2">
            <button class="btn btn-success btn-lg" onclick="openPayment()"><i class="bi bi-credit-card"></i> Pay</button>
            <div class="row g-2"><div class="col-6"><button class="btn btn-warning w-100" onclick="holdSale()"><i class="bi bi-pause-circle"></i> Hold</button></div><div class="col-6"><button class="btn btn-outline-secondary w-100" onclick="loadHeld()"><i class="bi bi-arrow-clockwise"></i> Recall</button></div></div>
            <button class="btn btn-outline-danger btn-sm" onclick="clearCart()">Clear Cart</button>
        </div>
    </div>
</div></div>

<div class="modal fade" id="paymentModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
<div class="modal-header"><h5 class="modal-title">Process Payment</h5></div>
<div class="modal-body">
    <p>Total: <strong id="modalTotal" class="text-success fs-4">$0.00</strong></p>
    <div class="mb-3"><label class="form-label">Method</label><select id="payMethod" class="form-select" onchange="onMethodChange()"><option value="0">Cash</option><option value="1">Card</option><option value="2">Mobile Wallet</option><option value="3">QR</option><option value="4">Gift Card</option><option value="5">Store Credit</option></select></div>
    <div class="mb-3"><label class="form-label">Amount</label><input type="number" id="payAmount" class="form-control" step="0.01" oninput="calcChange()"/></div>
    <div id="changeRow" class="mb-3"><label class="form-label">Change</label><input type="text" id="changeDisplay" class="form-control" readonly/></div>
    <div id="giftCardRow" class="mb-3 d-none">
        <label class="form-label">Gift Card Code</label>
        <div class="input-group">
            <input type="text" id="gcCode" class="form-control" placeholder="Enter gift card code" />
            <button class="btn btn-outline-secondary" type="button" onclick="validateGiftCard()"><i class="bi bi-search"></i> Validate</button>
        </div>
        <small id="gcMsg" class="text-muted mt-1 d-block"></small>
    </div>
    <div id="storeCreditRow" class="mb-3 d-none">
        <div class="alert alert-info py-2 mb-1">Store Credit Balance: <strong id="scBalance">$0.00</strong></div>
        <small class="text-muted">Amount above will be deducted from store credit.</small>
    </div>
</div>
<div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success" onclick="completeSale()"><i class="bi bi-check-lg"></i> Complete</button></div>
</div></div></div>

<div class="modal fade" id="heldModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
<div class="modal-header"><h5 class="modal-title">Held Sales</h5></div>
<div class="modal-body" id="heldSalesList"></div>
<div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
</div></div></div>

<div class="modal fade" id="variantModal" tabindex="-1"><div class="modal-dialog modal-md"><div class="modal-content">
<div class="modal-header">
  <h5 class="modal-title"><i class="bi bi-collection me-1"></i> Select Variant</h5>
  <small class="text-muted ms-2" id="variantModalProductName"></small>
  <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body" id="variantModalBody">
  <div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm"></div> Loading…</div>
</div>
</div></div></div>

@section Scripts {
<script>
let cart=[],appliedCoupon=null,appliedReward=null;
const branchId=@(ViewBag.BranchId?.ToString()??"null");
const allProducts=@Json.Serialize(ViewBag.ProductsList)||[];

// ──────────────────── Customer search ────────────────────
let _customerSearchTimer=null;
function searchCustomerLive(q){
  clearTimeout(_customerSearchTimer);
  const dd=document.getElementById('customerDropdown');
  if(q.length<2){dd.classList.add('d-none');dd.innerHTML='';return;}
  _customerSearchTimer=setTimeout(async()=>{
    try{
      const r=await fetch('/Sale/SearchCustomer?q='+encodeURIComponent(q));
      const list=await r.json();
      if(!list.length){dd.innerHTML='<span class="list-group-item py-1 text-muted small">No results</span>';dd.classList.remove('d-none');return;}
      dd.innerHTML=list.map(c=>`<button class="list-group-item list-group-item-action py-1 px-2 small" onclick="selectCustomer(${c.id},'${(c.name||'').replace(/'/g,"&#39;")}','${(c.phone||'').replace(/'/g,"&#39;")}')"><strong>${c.name||''}</strong>${c.phone?` &bull; <span class="text-muted">${c.phone}</span>`:''}</button>`).join('');
      dd.classList.remove('d-none');
    }catch(e){dd.classList.add('d-none');}
  },250);
}
function selectCustomer(id,name,phone){
  document.getElementById('selectedCustomerId').value=id;
  document.getElementById('customerSearch').value='';
  const badge=document.getElementById('selectedCustomerBadge');
  badge.textContent=name+(phone?' ('+phone+')':''); badge.classList.remove('d-none');
  document.getElementById('clearCustomerBtn').style.display='';
  document.getElementById('customerDropdown').classList.add('d-none');
  onCustomerChange();
}
function clearCustomer(){
  document.getElementById('selectedCustomerId').value='';
  document.getElementById('customerSearch').value='';
  document.getElementById('selectedCustomerBadge').classList.add('d-none');
  document.getElementById('clearCustomerBtn').style.display='none';
  document.getElementById('customerDropdown').classList.add('d-none');
  document.getElementById('loyaltyPanel').classList.add('d-none');
  clearReward();
}
// Close dropdown on outside click
document.addEventListener('click',e=>{
  if(!e.target.closest('#customerSearch')&&!e.target.closest('#customerDropdown'))
    document.getElementById('customerDropdown').classList.add('d-none');
});
function showToast(text,type){
  let c=document.getElementById('toastContainer');
  if(!c){c=document.createElement('div');c.id='toastContainer';c.className='position-fixed bottom-0 end-0 p-3';c.style.zIndex='9999';document.body.appendChild(c);}
  const t=document.createElement('div');t.className=`toast align-items-center text-bg-${type||'success'} border-0`;t.innerHTML=`<div class="d-flex"><div class="toast-body">${text}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
  c.appendChild(t);const bt=new bootstrap.Toast(t,{delay:3000});bt.show();t.addEventListener('hidden.bs.toast',()=>t.remove());
}
// ──────────────────── Loyalty / rewards ──────────────────
async function onCustomerChange(){
  const customerId=parseInt(document.getElementById('selectedCustomerId').value)||null;
  const panel=document.getElementById('loyaltyPanel');
  if(!customerId){panel.classList.add('d-none');clearReward();return;}
  try{
    const r=await fetch('/Sale/LoyaltyRewards?customerId='+customerId);
    const data=await r.json();
    document.getElementById('loyaltyPoints').textContent=data.points;
    document.getElementById('loyaltyTier').textContent=data.tier||'Standard';
    const list=document.getElementById('rewardsList');
    if(!data.rewards||!data.rewards.length){list.innerHTML='<small class="text-muted">No rewards available</small>';}
    else list.innerHTML=data.rewards.map(rw=>`<div class="d-flex justify-content-between align-items-center py-1 border-bottom"><small><strong>${rw.name}</strong> &mdash; ${rw.pointsRequired} pts</small><button class="btn btn-xs btn-outline-success py-0 px-1" onclick="redeemReward(${rw.id},'${rw.name.replace(/'/g,"&#39;")}',${ rw.discountValue})">-$${rw.discountValue.toFixed(2)}</button></div>`).join('');
    panel.classList.remove('d-none');
  }catch(e){panel.classList.add('d-none');}
  // Re-price cart items for customer's price rules
  for(const item of cart){
    try{
      const pr=await fetch(`/Product/GetAdjustedPrice?productId=${item.productId}&customerId=${customerId}`);
      const pd=await pr.json();
      if(pd.discountApplied) item.unitPrice=pd.price;
    }catch(e){}
  }
  renderCart();updateTotals();
}
function toggleRewards(){
  const p=document.getElementById('rewardsListPanel');
  p.classList.toggle('d-none');
}
async function redeemReward(rewardId,name,discountValue){
  const customerId=parseInt(document.getElementById('selectedCustomerId').value)||null;
  if(!customerId)return;
  if(!confirm(`Redeem reward "${name}" for -$${discountValue.toFixed(2)}?`))return;
  try{
    const r=await fetch('/Sale/RedeemReward',{method:'POST',headers:{'RequestVerificationToken':document.querySelector('input[name="__RequestVerificationToken"]')?.value||''},body:new URLSearchParams({customerId,rewardId})});
    const res=await r.json();
    if(res.success){
      appliedReward={id:rewardId,name,discountValue:res.discountValue};
      const msg=document.getElementById('rewardMsg');
      msg.textContent='✓ Reward applied: -$'+res.discountValue.toFixed(2);
      msg.className='text-success';
      document.getElementById('rewardsListPanel').classList.add('d-none');
      onCustomerChange();
      updateTotals();
    }else alert('Error: '+(res.message||'Could not redeem reward'));
  }catch(e){alert('Error redeeming reward.');}
}
function clearReward(){appliedReward=null;document.getElementById('rewardMsg').textContent='';}
document.getElementById('barcodeInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();searchProduct();}});
document.getElementById('barcodeInput').addEventListener('input',e=>{renderProductGrid(e.target.value.trim());});
async function searchProduct(){
  const q=document.getElementById('barcodeInput').value.trim();
  if(!q)return;
  try{
    const r=await fetch('/Product/ByBarcode?barcode='+encodeURIComponent(q));
    if(r.ok){const p=await r.json();openVariantPickerOrAdd(p);document.getElementById('barcodeInput').value='';renderProductGrid('');return;}
  }catch(e){}
  renderProductGrid(q);
}
// ─── Variant picker ───────────────────────────────────────
let _variantPickerProduct=null;
function openVariantPickerOrAdd(p){
  if(!p.hasVariants){addToCart(p);return;}
  _variantPickerProduct=p;
  document.getElementById('variantModalProductName').textContent=p.name;
  document.getElementById('variantModalBody').innerHTML='<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm"></div> Loading…</div>';
  new bootstrap.Modal(document.getElementById('variantModal')).show();
  fetch('/Product/GetVariantsWithBranchStock?productId='+p.id)
    .then(r=>r.json())
    .then(variants=>{
      if(!variants.length){
        document.getElementById('variantModalBody').innerHTML='<p class="text-muted text-center">No variants found. Adding base product.</p>';
        setTimeout(()=>{bootstrap.Modal.getInstance(document.getElementById('variantModal')).hide();addToCart(p);},1000);
        return;
      }
      document.getElementById('variantModalBody').innerHTML=`
        <p class="text-muted small mb-3">Select variant and branch availability:</p>
        <div class="row g-2">
        ${variants.map(v=>{
          const attrBadges=(v.attributes||[]).map(a=>`<span class="badge bg-light text-dark border me-1">${a.name}: ${a.value}</span>`).join('');
          const totalStock=v.stockByBranch.reduce((s,b)=>s+b.qtyOnHand,0);
          const stockDisabled=totalStock===0;
          const branchStockHtml=(v.stockByBranch||[]).length>0
            ?`<div class="small text-muted mt-2 border-top pt-2 bg-light p-2 rounded">${v.stockByBranch.map(bs=>`<div class="d-flex justify-content-between"><span><strong>${bs.branchName}:</strong></span><span class="fw-bold ${bs.qtyOnHand===0?'text-danger':'text-success'}">${bs.qtyOnHand} qty</span></div>`).join('')}</div>`
            :'<div class="small text-danger mt-2">No stock available</div>';
          return `<div class="col-12">
            <button class="btn btn-outline-primary w-100 text-start py-2 px-3" style="min-height:auto"
              onclick="addVariantToCart(${v.id},'${(v.label||'').replace(/'/g,"&#39;")}','${(v.sku||'').replace(/'/g,"&#39;")}',${ v.price},${totalStock})"
              ${stockDisabled?'disabled':''}>
              <div class="fw-bold">${v.label||v.sku||'Variant'}</div>
              <div class="small mt-1">${attrBadges}</div>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <span class="text-success fw-bold">$${v.price.toFixed(2)}</span>
                ${totalStock===0?'<span class="badge bg-danger">Out</span>':totalStock<=5?`<span class="badge bg-warning text-dark">${totalStock} available</span>`:`<span class="badge bg-success">${totalStock} available</span>`}
              </div>
              ${branchStockHtml}
            </button>
          </div>`;
        }).join('')}
        </div>`;
    })
    .catch(()=>{document.getElementById('variantModalBody').innerHTML='<p class="text-danger">Failed to load variants.</p>';});
}
function addVariantToCart(variantId,variantLabel,variantSku,variantPrice,stockQty){
  const p=_variantPickerProduct;
  bootstrap.Modal.getInstance(document.getElementById('variantModal')).hide();
  const existing=cart.find(i=>i.productId===p.id&&i.variantId===variantId);
  if(existing){existing.qty++;renderCart();updateTotals();return;}
  let autoDisc=0;
  if(p.autoDiscountType&&p.autoDiscountValue>0){
    if(p.autoDiscountType==='Percentage') autoDisc=variantPrice*p.autoDiscountValue/100;
    else if(p.autoDiscountType==='FixedAmount') autoDisc=p.autoDiscountValue;
  }
  cart.push({productId:p.id,productName:p.name+' — '+variantLabel,sku:variantSku||p.sku,variantId:variantId,qty:1,
    unitPrice:variantPrice,discount:parseFloat(autoDisc.toFixed(4)),
    taxRate:p.effectiveTaxRate!==undefined?p.effectiveTaxRate:(p.taxRateValue||0)});
  renderCart();updateTotals();
}
function addToCart(p){const e=cart.find(i=>i.productId===p.id);if(e)e.qty++;else{
  // Compute auto-discount from category-level scheduled discount
  let autoDisc=0;
  if(p.autoDiscountType&&p.autoDiscountValue>0){
    if(p.autoDiscountType==='Percentage') autoDisc=p.price*p.autoDiscountValue/100;
    else if(p.autoDiscountType==='FixedAmount') autoDisc=p.autoDiscountValue;
  }
  cart.push({productId:p.id,productName:p.name,sku:p.sku,variantId:null,qty:1,
    unitPrice:p.price,discount:parseFloat(autoDisc.toFixed(4)),
    taxRate:p.effectiveTaxRate!==undefined?p.effectiveTaxRate:(p.taxRateValue||0)});
}renderCart();updateTotals();}
function renderCart(){const d=document.getElementById('cartItems');if(!cart.length){d.innerHTML='<p class="text-muted text-center mt-4">Cart is empty</p>';return;}d.innerHTML=cart.map((item,i)=>`<div class="card mb-2 p-2"><div class="d-flex justify-content-between align-items-start"><div><strong>${item.productName}</strong><br><small class="text-muted">${item.sku||''}</small></div><button class="btn btn-sm btn-outline-danger" onclick="removeItem(${i})"><i class="bi bi-x"></i></button></div><div class="d-flex align-items-center gap-2 mt-1"><button class="btn btn-sm btn-outline-secondary" onclick="changeQty(${i},-1)">-</button><input type="number" class="form-control form-control-sm text-center" style="width:60px" value="${item.qty}" onchange="setQty(${i},this.value)" min="1"><button class="btn btn-sm btn-outline-secondary" onclick="changeQty(${i},1)">+</button><span class="ms-auto fw-bold">$${((item.unitPrice-item.discount)*item.qty).toFixed(2)}</span></div></div>`).join('');}
function removeItem(i){cart.splice(i,1);renderCart();updateTotals();}
function changeQty(i,d){cart[i].qty=Math.max(1,cart[i].qty+d);renderCart();updateTotals();}
function setQty(i,v){cart[i].qty=Math.max(1,parseInt(v)||1);updateTotals();}
function clearCart(){cart=[];appliedCoupon=null;document.getElementById('couponCode').value='';document.getElementById('couponMsg').textContent='';renderCart();updateTotals();}
function updateTotals(){let sub=cart.reduce((s,i)=>s+(i.unitPrice-i.discount)*i.qty,0),tax=cart.reduce((s,i)=>s+(i.unitPrice-i.discount)*i.qty*(i.taxRate||0),0),disc=parseFloat(document.getElementById('discountInput').value)||0;if(appliedCoupon){if(appliedCoupon.type==='Percentage')disc+=sub*appliedCoupon.value/100;else if(appliedCoupon.type==='FixedAmount')disc+=appliedCoupon.value;}if(appliedReward)disc+=appliedReward.discountValue;document.getElementById('subtotal').textContent='$'+sub.toFixed(2);document.getElementById('taxDisplay').textContent='$'+tax.toFixed(2);document.getElementById('totalDisplay').textContent='$'+Math.max(0,sub+tax-disc).toFixed(2);}
function openPayment(){if(!cart.length){alert('Cart is empty');return;}const t=parseFloat(document.getElementById('totalDisplay').textContent.replace('$',''));document.getElementById('modalTotal').textContent='$'+t.toFixed(2);document.getElementById('payAmount').value=t.toFixed(2);calcChange();onMethodChange();new bootstrap.Modal(document.getElementById('paymentModal')).show();}
function calcChange(){const t=parseFloat(document.getElementById('modalTotal').textContent.replace('$','')),p=parseFloat(document.getElementById('payAmount').value)||0;document.getElementById('changeDisplay').value='$'+Math.max(0,p-t).toFixed(2);}
function onMethodChange(){const m=parseInt(document.getElementById('payMethod').value);document.getElementById('changeRow').style.display=m===0?'':'none';document.getElementById('giftCardRow').classList.toggle('d-none',m!==4);document.getElementById('storeCreditRow').classList.toggle('d-none',m!==5);if(m===5){const cid=parseInt(document.getElementById('selectedCustomerId').value)||null;if(cid)fetch('/Sale/StoreCreditBalance?customerId='+cid).then(r=>r.json()).then(d=>{document.getElementById('scBalance').textContent='$'+(d.balance||0).toFixed(2);});}}
async function validateGiftCard(){const code=document.getElementById('gcCode').value.trim();if(!code)return;const r=await fetch('/Sale/ValidateGiftCard?code='+encodeURIComponent(code));const d=await r.json();const msg=document.getElementById('gcMsg');if(d.valid){const t=parseFloat(document.getElementById('modalTotal').textContent.replace('$',''));document.getElementById('payAmount').value=Math.min(d.balance,t).toFixed(2);msg.textContent='✓ Valid — Balance: $'+d.balance.toFixed(2);msg.className='text-success mt-1 d-block';}else{msg.textContent='✗ Invalid or expired gift card';msg.className='text-danger mt-1 d-block';}}
async function completeSale(){
  const t=parseFloat(document.getElementById('modalTotal').textContent.replace('$','')),
    paid=parseFloat(document.getElementById('payAmount').value),
    method=parseInt(document.getElementById('payMethod').value),
    change=Math.max(0,paid-t);
  // Build total discount = manual + coupon + reward
  const sub=cart.reduce((s,i)=>s+(i.unitPrice-i.discount)*i.qty,0);
  let disc=parseFloat(document.getElementById('discountInput').value)||0;
  if(appliedCoupon){
    if(appliedCoupon.type==='Percentage') disc+=sub*appliedCoupon.value/100;
    else if(appliedCoupon.type==='FixedAmount') disc+=appliedCoupon.value;
  }
  if(appliedReward) disc+=appliedReward.discountValue;
  const customerId=parseInt(document.getElementById('selectedCustomerId').value)||null,
    couponCode=document.getElementById('couponCode').value.trim()||null,
    reference=(method===4?document.getElementById('gcCode').value.trim()||null:null);
  const r=await fetch('/Sale/Complete',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':document.querySelector('input[name="__RequestVerificationToken"]')?.value||''},body:JSON.stringify({items:cart.map(i=>({productId:i.productId,productName:i.productName,sku:i.sku,variantId:i.variantId,qty:i.qty,unitPrice:i.unitPrice,discount:i.discount})),payments:[{method,amount:paid,change:method===0?change:null,reference}],customerId,branchId,discount:disc,couponCode})});
  const res=await r.json();if(res.success){bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide();clearCart();clearReward();if(confirm('Sale complete! Print receipt?'))window.open('/Sale/Receipt/'+res.saleId,'_blank');}else alert('Error: '+res.message);}
async function holdSale(){
  if(!cart.length){alert('Cart is empty');return;}
  const label=prompt('Label for this hold (optional):', '');
  if(label===null)return; // cancelled
  const notes=prompt('Notes (optional):', '')||'';
  const couponCode=document.getElementById('couponCode').value.trim()||null;
  const manualDiscount=parseFloat(document.getElementById('discountInput').value)||0;
  const customerId=parseInt(document.getElementById('selectedCustomerId').value)||null;
  const r=await fetch('/Sale/Hold',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':document.querySelector('input[name="__RequestVerificationToken"]')?.value||''},
    body:JSON.stringify({items:cart,customerId,branchId,holdLabel:label.trim()||null,holdNotes:notes.trim()||null,couponCode,manualDiscount})});
  const res=await r.json();
  if(res.success){clearCart();alert('Sale held.'+((label.trim())?' Label: '+label.trim():''));}
  else alert('Error holding sale.');
}
async function loadHeld(){
  const r=await fetch('/Sale/HeldSales');
  const sales=await r.json();
  const now=new Date();
  document.getElementById('heldSalesList').innerHTML=!sales.length
    ? '<p class="text-muted">No held sales.</p>'
    : sales.map(s=>{
        const age=Math.round((now-new Date(s.createdAt))/60000);
        const expiry=s.holdExpiresAt?`<span class="text-danger ms-2">Expires in ${Math.max(0,Math.round((new Date(s.holdExpiresAt)-now)/60000))}m</span>`:""; 
        const lbl=s.holdLabel?`<span class="badge bg-warning text-dark me-1">${s.holdLabel}</span>`:""; 
        return `<div class="card mb-2 p-3">
          <div class="d-flex justify-content-between align-items-start">
            <div>${lbl}<strong>${s.saleNumber}</strong>${expiry}<br>
              <small class="text-muted">${s.customerName||'Walk-in'} &bull; ${s.items.length} item(s) &bull; $${s.total.toFixed(2)} &bull; ${age}m ago</small>
              ${s.holdNotes?`<br><small class="text-secondary">${s.holdNotes}</small>`:""}
            </div>
            <div class="d-flex gap-1">
              <button class="btn btn-sm btn-success" onclick='recallSale(${JSON.stringify(s).replace(/'/g,"&#39;")})'>Recall</button>
              <button class="btn btn-sm btn-outline-danger" onclick='voidHeld(${s.id},this)'>Void</button>
            </div>
          </div></div>`;
      }).join('');
  new bootstrap.Modal(document.getElementById('heldModal')).show();
}
function recallSale(sale){
  clearCart();
  sale.items.forEach(i=>cart.push({productId:i.productId,productName:i.productName,sku:i.sku||'',variantId:i.variantId,qty:i.qty,unitPrice:i.unitPrice,discount:i.discount,taxRate:i.taxRateSnapshot||0}));
  // Restore manual discount
  if(sale.holdDiscountAmount>0) document.getElementById('discountInput').value=sale.holdDiscountAmount.toFixed(2);
  // Restore coupon code (user can re-validate)
  if(sale.holdCouponCode){
    document.getElementById('couponCode').value=sale.holdCouponCode;
    applyCoupon();
  }
  renderCart();updateTotals();
  bootstrap.Modal.getInstance(document.getElementById('heldModal')).hide();
}
async function voidHeld(id,btn){
  if(!confirm('Void this held sale?'))return;
  btn.disabled=true;
  const r=await fetch('/Sale/VoidHeld?id='+id,{method:'POST',headers:{'RequestVerificationToken':document.querySelector('input[name="__RequestVerificationToken"]')?.value||''}});
  const res=await r.json();
  if(res.success) btn.closest('.card').remove();
  else { btn.disabled=false; alert('Error voiding sale.'); }
}
async function applyCoupon(){const code=document.getElementById('couponCode').value.trim();if(!code)return;const r=await fetch('/Sale/ValidateCoupon?code='+encodeURIComponent(code));const res=await r.json();const msg=document.getElementById('couponMsg');if(res.valid){appliedCoupon=res;msg.textContent='✓ Applied';msg.className='text-success';}else{appliedCoupon=null;msg.textContent='✗ Invalid';msg.className='text-danger';}updateTotals();}
renderCart();updateTotals();
// ─── Product browser ─────────────────────────────────────
let _activeCat=0;
function initCategoryTabs(){
  const cats=[...new Map(allProducts.map(p=>[p.categoryId,p.categoryName])).entries()]
    .filter(([,n])=>n).sort((a,b)=>(a[1]||'').localeCompare(b[1]||''));
  document.getElementById('catTabs').innerHTML=cats.map(([id,name])=>
    `<button class="btn btn-sm btn-outline-secondary me-1 mb-1 cat-btn" data-cat="${id}" onclick="filterCategory(${id},this)">${name}</button>`
  ).join('');
}
function filterCategory(catId,btn){
  _activeCat=catId;
  document.querySelectorAll('.cat-btn').forEach(b=>{b.classList.remove('btn-primary','active');b.classList.add('btn-outline-secondary');});
  btn.classList.remove('btn-outline-secondary');btn.classList.add('btn-primary','active');
  document.getElementById('barcodeInput').value='';renderProductGrid('');
}
function renderProductGrid(q){
  const sq=(q||'').toLowerCase().trim();
  let list=_activeCat===0?[...allProducts]:allProducts.filter(p=>p.categoryId===_activeCat);
  if(sq) list=list.filter(p=>(p.name||'').toLowerCase().includes(sq)||(p.sku||'').toLowerCase().includes(sq)||(p.barcode||'').toLowerCase().includes(sq));
  const el=document.getElementById('productGridInner');
  if(!list.length){el.innerHTML='<div class="col-12 text-center text-muted py-5"><i class="bi bi-search fs-1 d-block mb-2 opacity-25"></i><div>No products found</div></div>';return;}
  el.innerHTML=list.map(p=>{
    var pj=JSON.stringify(p).replace(/'/g,"&#39;");
    var discBadge=p.autoDiscountValue>0?`<span class="badge bg-warning text-dark ms-1">${p.autoDiscountType==='Percentage'?p.autoDiscountValue+'%':'$'+p.autoDiscountValue} off</span>`:'';
    var varBadge=p.hasVariants?'<span class="badge bg-info text-white ms-1"><i class="bi bi-collection"></i></span>':'';
    var img=p.imageUrl?`<img src="${p.imageUrl}" class="card-img-top" style="height:72px;object-fit:cover">`
      :'<div class="bg-light d-flex align-items-center justify-content-center" style="height:72px"><i class="bi bi-box-seam fs-2 text-secondary opacity-25"></i></div>';
    return `<div class="col-6 col-sm-4 col-xl-3"><div class="card h-100 border-0 shadow-sm product-tile" style="cursor:pointer" onclick='openVariantPickerOrAdd(${pj})' title="${(p.name||'').replace(/"/g,'&quot;')}">${img}<div class="card-body p-2"><div class="small fw-semibold lh-sm mb-1 text-truncate" title="${p.name||''}">${p.name}</div><div class="small text-muted text-truncate">${p.categoryName||''}</div><div class="d-flex align-items-center flex-wrap mt-1"><span class="fw-bold text-success small me-1">$${p.price.toFixed(2)}</span>${varBadge}${discBadge}</div></div></div></div>`;
  }).join('');
}
function clearSearch(){document.getElementById('barcodeInput').value='';renderProductGrid('');}
initCategoryTabs();
renderProductGrid('');
</script>@Html.AntiForgeryToken()}
