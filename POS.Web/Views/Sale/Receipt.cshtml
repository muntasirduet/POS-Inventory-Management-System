@model POS.Application.DTOs.SaleDto
@{ ViewData["Title"] = "Receipt"; Layout = null; }
<!DOCTYPE html><html><head><meta charset="utf-8"/><title>Receipt @ViewBag.ReceiptNumber</title>
<style>body{font-family:'Courier New',monospace;max-width:320px;margin:0 auto;padding:10px;}.divider{border-top:1px dashed #000;margin:8px 0;}table{width:100%;font-size:.85em;}td{padding:2px 0;}.total{font-size:1.1em;font-weight:bold;}@@media print{.no-print{display:none;}}</style></head>
<body>
<h1 style="text-align:center;font-size:1.2em">@ViewBag.StoreName</h1>
<p style="text-align:center;font-size:.8em">@ViewBag.StorePhone</p>
<div class="divider"></div>
<p>Receipt: @ViewBag.ReceiptNumber</p><p>Date: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
@if(!string.IsNullOrEmpty(Model.CustomerName)){<p>Customer: @Model.CustomerName</p>}
<div class="divider"></div>
<table><tr><th style="text-align:left">Item</th><th style="text-align:center">Qty</th><th style="text-align:right">Total</th></tr>
@foreach(var item in Model.Items){<tr><td>@item.ProductName</td><td style="text-align:center">@item.Qty x $@item.UnitPrice.ToString("N2")</td><td style="text-align:right">$@item.LineTotal.ToString("N2")</td></tr>}</table>
<div class="divider"></div>
<table><tr><td>Subtotal</td><td style="text-align:right">$@Model.SubTotal.ToString("N2")</td></tr>
<tr><td>Tax</td><td style="text-align:right">$@Model.Tax.ToString("N2")</td></tr>
@if(Model.Discount>0){<tr><td>Discount</td><td style="text-align:right">-$@Model.Discount.ToString("N2")</td></tr>}
<tr class="total"><td>TOTAL</td><td style="text-align:right">$@Model.Total.ToString("N2")</td></tr></table>
<div class="divider"></div>
@foreach(var p in Model.Payments){<p>@p.Method: $@p.Amount.ToString("N2") @(p.Change>0?$"(Change: ${p.Change:N2}":"")</p>}
<div class="divider"></div><p style="text-align:center">Thank you!</p>
<div class="no-print" style="text-align:center;margin-top:20px"><button onclick="window.print()" style="padding:8px 20px;cursor:pointer">Print</button><button onclick="window.close()" style="padding:8px 20px;cursor:pointer;margin-left:10px">Close</button></div>
</body></html>
