@{ ViewData["Title"] = "New Return — Look Up Sale"; }
<h2>@ViewData["Title"]</h2>

@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row"><div class="col-md-5">
<div class="card"><div class="card-body">
    <p class="text-muted">Enter the original sale number to begin the return process.</p>
    <form asp-action="LookupSale" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label fw-semibold">Sale Number</label>
            <input type="text" name="saleNumber" class="form-control" placeholder="SALE-20260401-XXXXXX" autofocus required />
        </div>
        <button type="submit" class="btn btn-primary">Find Sale</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
</div></div>
