@model POS.Core.Entities.Customer
@{ ViewData["Title"] = Model.Name; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-person-circle"></i> @Model.Name</h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div>
}

<div class="row g-3">
    <!-- Profile card -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Profile</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Phone</dt><dd class="col-7">@(Model.Phone ?? "—")</dd>
                    <dt class="col-5">Email</dt><dd class="col-7">@(Model.Email ?? "—")</dd>
                    <dt class="col-5">Address</dt><dd class="col-7">@(Model.Address ?? "—")</dd>
                    <dt class="col-5">Since</dt><dd class="col-7">@Model.CreatedAt.ToString("MMM d, yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Loyalty card -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-star-fill text-warning"></i> Loyalty</span>
                @{
                    var tier = Model.LoyaltyAccount?.Tier ?? "Standard";
                    var tierClass = tier switch { "Platinum" => "bg-dark", "Gold" => "bg-warning text-dark", "Silver" => "bg-secondary", _ => "bg-light text-dark border" };
                }
                <span class="badge @tierClass">@tier</span>
            </div>
            <div class="card-body">
                @if (Model.LoyaltyAccount != null)
                {
                    <div class="text-center mb-3">
                        <div class="display-6 fw-bold text-primary">@Model.LoyaltyAccount.Points.ToString("N0")</div>
                        <div class="text-muted small">points available</div>
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-6">Total Spend</dt><dd class="col-6">$@Model.LoyaltyAccount.TotalSpend.ToString("0.00")</dd>
                    </dl>
                    <div class="mt-3">
                        <a asp-controller="Loyalty" asp-action="Customer" asp-route-id="@Model.Id"
                           class="btn btn-sm btn-outline-primary w-100">
                            <i class="bi bi-clock-history"></i> Full Loyalty History
                        </a>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">No loyalty account</p>
                }
            </div>
        </div>
    </div>

    <!-- Membership card -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Membership</span>
                @if (User.HasClaim("permission", "customers.edit"))
                {
                    <a asp-controller="Customer" asp-action="EditMembership" asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-secondary py-0">
                        <i class="bi bi-pencil"></i>
                    </a>
                }
            </div>
            <div class="card-body">
                @if (Model.Membership != null)
                {
                    var expired = Model.Membership.ExpiresAt < DateTime.Now;
                    <dl class="row mb-0">
                        <dt class="col-6">Type</dt>
                        <dd class="col-6">
                            @Model.Membership.MembershipType.ToString()
                            @if (expired) { <span class="badge bg-danger ms-1">Expired</span> }
                        </dd>
                        <dt class="col-6">Valid Until</dt>
                        <dd class="col-6 @(expired ? "text-danger" : "")">@Model.Membership.ExpiresAt.ToString("MMM d, yyyy")</dd>
                    </dl>
                }
                else
                {
                    <p class="text-muted text-center mt-3">No membership</p>
                    @if (User.HasClaim("permission", "customers.edit"))
                    {
                        <div class="text-center mt-2">
                            <a asp-controller="Customer" asp-action="EditMembership" asp-route-id="@Model.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg"></i> Add Membership
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent Sales -->
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-receipt"></i> Recent Sales</span>
        <small class="text-muted">Last 10</small>
    </div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr><th>Sale #</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td><a asp-controller="Sale" asp-action="Receipt" asp-route-id="@sale.Id">@sale.SaleNumber</a></td>
                        <td>@sale.CreatedAt.ToString("MMM d, yyyy HH:mm")</td>
                        <td>@sale.Items.Count</td>
                        <td class="fw-bold">$@sale.Total.ToString("0.00")</td>
                        <td><span class="badge bg-@(sale.Status == POS.Core.Enums.SaleStatus.Completed ? "success" : "warning")">@sale.Status</span></td>
                    </tr>
                }
                @if (!Model.Sales.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No sales yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Loyalty Transactions -->
@if (Model.LoyaltyAccount?.Transactions.Any() == true)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clock-history"></i> Loyalty History</span>
            <small class="text-muted">Last 20</small>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Type</th><th>Points</th><th>Balance After</th><th>Notes</th></tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.LoyaltyAccount.Transactions)
                    {
                        <tr>
                            <td>@tx.CreatedAt.ToString("MMM d, yyyy HH:mm")</td>
                            <td>
                                @{
                                    var txClass = tx.Type == "Earn" ? "text-success" : tx.Type == "Redeem" ? "text-danger" : "text-secondary";
                                    var txIcon = tx.Type == "Earn" ? "bi-plus-circle" : tx.Type == "Redeem" ? "bi-dash-circle" : "bi-arrow-left-right";
                                }
                                <span class="@txClass"><i class="bi @txIcon"></i> @tx.Type</span>
                            </td>
                            <td class="@(tx.Points >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">@(tx.Points >= 0 ? "+" : "")@tx.Points</td>
                            <td>@tx.BalanceAfter.ToString("N0")</td>
                            <td class="text-muted small">@tx.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
