@model List<POS.Core.Entities.StockItem>
@{ ViewData["Title"] = "Stock Levels"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-boxes"></i> Stock Levels</h2>
    <div class="d-flex gap-2">
        <a asp-action="LowStock" class="btn btn-warning btn-sm"><i class="bi bi-exclamation-triangle"></i> Low Stock</a>
        <a asp-action="Adjust" class="btn btn-outline-primary btn-sm"><i class="bi bi-sliders"></i> Adjust Stock</a>
        <a asp-action="Transfer" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left-right"></i> Transfer</a>
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Branch</th>
                    <th class="text-end">Qty On Hand</th>
                    <th class="text-end">Reorder Level</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isLow = item.QtyOnHand <= item.ReorderLevel;
                    <tr class="@(isLow ? "table-warning" : "")">
                        <td><strong>@item.Product?.Name</strong></td>
                        <td><code>@item.Product?.SKU</code></td>
                        <td>@item.Branch?.Name</td>
                        <td class="text-end fw-bold @(isLow ? "text-danger" : "")">@item.QtyOnHand</td>
                        <td class="text-end">@item.ReorderLevel</td>
                        <td>
                            @if (isLow)
                            {
                                <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Low</span>
                            }
                            else
                            {
                                <span class="badge bg-success">OK</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No stock records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
