@{ ViewData["Title"] = "Adjust Stock"; }
<h2><i class="bi bi-sliders"></i> Adjust Stock</h2>
<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body">
        <form asp-action="Adjust" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Product</label>
                <select name="productId" class="form-select" required>
                    <option value="">-- Select Product --</option>
                    @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Products)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select" required>
                    <option value="">-- Select Branch --</option>
                    @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Branches)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">New Quantity On Hand</label>
                <input type="number" name="qty" class="form-control" min="0" required />
                <div class="form-text">Enter the corrected total quantity (not a delta).</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Notes / Reason</label>
                <textarea name="notes" class="form-control" rows="2" placeholder="e.g. Physical count correction"></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Apply Adjustment</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
