@model List<POS.Core.Entities.PurchaseOrder>
@{ ViewData["Title"] = "Purchase Orders"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-cart-plus"></i> Purchase Orders</h2>
    <a asp-action="CreatePurchaseOrder" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New Order</a>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var po in Model)
                {
                    <tr>
                        <td><small>@po.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                        <td>@po.Supplier?.Name</td>
                        <td>@po.Branch?.Name</td>
                        <td>
                            @switch (po.Status.ToString())
                            {
                                case "Draft":
                                    <span class="badge bg-secondary">Draft</span>
                                    break;
                                case "Ordered":
                                    <span class="badge bg-primary">Ordered</span>
                                    break;
                                case "Received":
                                    <span class="badge bg-success">Received</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger">Cancelled</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@po.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end fw-bold">$@po.Total.ToString("N2")</td>
                        <td><small class="text-muted">@po.Notes</small></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No purchase orders found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
