@model POS.Core.Entities.PurchaseOrder
@using POS.Core.Enums
@{ ViewData["Title"] = $"Purchase Order #{Model.Id}"; }

@{
    var badgeClass = Model.Status switch {
        PurchaseOrderStatus.Draft             => "bg-secondary",
        PurchaseOrderStatus.Ordered           => "bg-primary",
        PurchaseOrderStatus.PartiallyReceived => "bg-warning text-dark",
        PurchaseOrderStatus.Received          => "bg-success",
        PurchaseOrderStatus.Cancelled         => "bg-danger",
        _                                     => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-file-earmark-text"></i> Purchase Order <span class="text-muted">#@Model.Id</span></h2>
    <a asp-action="PurchaseOrders" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Error"]</div> }

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><strong>Order Info</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @badgeClass fs-6">@Model.Status</span></dd>
                    <dt class="col-sm-4">Supplier</dt>
                    <dd class="col-sm-8">@Model.Supplier.Name</dd>
                    <dt class="col-sm-4">Branch</dt>
                    <dd class="col-sm-8">@Model.Branch.Name</dd>
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">@(Model.Notes ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6 d-flex flex-column gap-2 justify-content-start">
        @if (Model.Status == PurchaseOrderStatus.Draft)
        {
            <form method="post" asp-action="SubmitPurchaseOrder" asp-route-id="@Model.Id" onsubmit="return confirm('Submit this order to the supplier?')">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary w-100"><i class="bi bi-send"></i> Submit to Supplier</button>
            </form>
        }
        @if (Model.Status == PurchaseOrderStatus.Ordered || Model.Status == PurchaseOrderStatus.PartiallyReceived)
        {
            <a asp-action="ReceivePurchaseOrder" asp-route-id="@Model.Id" class="btn btn-success w-100">
                <i class="bi bi-box-arrow-in-down"></i> Receive Stock
            </a>
        }
        @if (Model.Status != PurchaseOrderStatus.Received && Model.Status != PurchaseOrderStatus.Cancelled)
        {
            <form method="post" asp-action="CancelPurchaseOrder" asp-route-id="@Model.Id" onsubmit="return confirm('Cancel this purchase order?')">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle"></i> Cancel Order</button>
            </form>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong><i class="bi bi-list-ul"></i> Order Items</strong>
        <strong>Total: $@Model.Total.ToString("N2")</strong>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th class="text-center">Ordered Qty</th>
                    <th class="text-center">Received Qty</th>
                    <th class="text-center">Remaining</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Line Total</th>
                    <th class="text-center">Progress</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    int remaining = item.Qty - item.ReceivedQty;
                    int pct = item.Qty > 0 ? (int)Math.Round((double)item.ReceivedQty / item.Qty * 100) : 0;
                    <tr>
                        <td><strong>@item.Product.Name</strong><br /><small class="text-muted">@item.Product.SKU</small></td>
                        <td class="text-center">@item.Qty</td>
                        <td class="text-center">
                            <span class="badge @(item.ReceivedQty >= item.Qty ? "bg-success" : item.ReceivedQty > 0 ? "bg-warning text-dark" : "bg-secondary")">
                                @item.ReceivedQty
                            </span>
                        </td>
                        <td class="text-center">@(remaining > 0 ? remaining.ToString() : "—")</td>
                        <td class="text-end">$@item.UnitCost.ToString("N2")</td>
                        <td class="text-end">$@item.LineTotal.ToString("N2")</td>
                        <td style="min-width:100px">
                            <div class="progress" style="height:6px" title="@pct% received">
                                <div class="progress-bar @(pct == 100 ? "bg-success" : "bg-primary")" style="width:@pct%"></div>
                            </div>
                            <small class="text-muted">@pct%</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
