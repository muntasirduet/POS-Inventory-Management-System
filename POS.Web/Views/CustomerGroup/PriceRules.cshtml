@model POS.Core.Entities.CustomerGroup
@{ ViewData["Title"] = "Price Rules — " + Model.Name; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-tag-fill"></i> Price Rules: @Model.Name</h4>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div> }

<div class="card mb-4">
    <div class="card-header"><strong>Add Price Rule</strong></div>
    <div class="card-body">
        <form asp-action="AddPriceRule" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupId" value="@Model.Id" />
            <div class="col-md-3"><input name="name" class="form-control" placeholder="Rule name" required /></div>
            <div class="col-md-2">
                <select name="discountType" class="form-select">
                    <option value="Percentage">Percentage %</option>
                    <option value="FixedAmount">Fixed Amount $</option>
                    <option value="FixedPrice">Fixed Price $</option>
                </select>
            </div>
            <div class="col-md-1"><input name="value" type="number" step="0.01" min="0" class="form-control" placeholder="Value" required /></div>
            <div class="col-md-2">
                <select name="productId" class="form-select">
                    <option value="">Any product</option>
                    @foreach (var p in ViewBag.Products as List<POS.Core.Entities.Product> ?? new()) { <option value="@p.Id">@p.Name</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select name="categoryId" class="form-select">
                    <option value="">Any category</option>
                    @foreach (var c in ViewBag.Categories as List<POS.Core.Entities.Category> ?? new()) { <option value="@c.Id">@c.Name</option> }
                </select>
            </div>
            <div class="col-md-1"><input name="priority" type="number" class="form-control" placeholder="Priority" value="0" /></div>
            <div class="col-md-1"><button type="submit" class="btn btn-primary w-100">Add</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Type</th><th>Value</th><th>Product</th><th>Category</th><th>Priority</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var rule in Model.PriceRules.OrderByDescending(r => r.Priority))
                {
                    <tr>
                        <td>@rule.Name</td>
                        <td>@rule.DiscountType</td>
                        <td class="fw-bold">@(rule.DiscountType == "Percentage" ? $"{rule.Value:0.##}%" : $"${rule.Value:0.00}")</td>
                        <td>@(rule.Product?.Name ?? "Any")</td>
                        <td>@(rule.Category?.Name ?? "Any")</td>
                        <td>@rule.Priority</td>
                        <td><span class="badge @(rule.IsActive ? "bg-success" : "bg-secondary")">@(rule.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <form asp-action="DeletePriceRule" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ruleId" value="@rule.Id" />
                                <input type="hidden" name="groupId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete rule?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.PriceRules.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No price rules yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
